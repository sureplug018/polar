<%- include('partials/dashboardHeader') %>
<div class="content">
  <%- include('partials/dashboardHead') %>
  <main class="page">

    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">Referrals</h1>
      <p class="muted" style="margin:6px 0 0">Invite investors and earn commission on their capital.</p>
    </div>
    <div class="grid g4">
      <div class="card stat featured">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Referral earnings</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" />
              <circle cx="9.5" cy="8" r="3.2" />
              <path d="M18 8.5h4" />
              <path d="M20 6.5v4" />
            </svg></span>
        </div>
        <p class="stat-value">$<%= totalReferralEarningsFormatted %></p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Total referrals</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20" />
              <circle cx="8.5" cy="8" r="3.2" />
              <path d="M17 4.3a4 4 0 0 1 0 7.4" />
              <path d="M21 20v-1.5a4 4 0 0 0-3-3.8" />
            </svg></span>
        </div>
        <p class="stat-value"><%= referrals.length %></p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Active referrals</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 16 5-5 4 4 8-8" />
              <path d="M20 7v5h-5" />
            </svg></span>
        </div>
        <p class="stat-value"><%= activeReferrals.length %></p>
      </div>
    </div>
    <div class="card mt">
      <p class="eyebrow">Your referral link</p>
      <div class="copy-box mt-sm"><span id="ref">https://polarfincorp.com/register?ref=<%= user.myReferralCode %></span>
        <button class="btn sm ghost" onclick="copyText(document.getElementById('ref').textContent, this)">Copy</button>
      </div>
      <p class="muted small mt-sm">Code: <strong><%= user.myReferralCode %></strong></p>
    </div>
    <div class="mt">
      <div class="card table-card" data-paginate="10" id="tbl4" style="padding:6px">
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Joined</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% referrals.forEach(referral => { %>
              <tr>
                <td><%= referral.firstName %> <%= referral.lastName %></td>
                <td><%= referral.email %></td>
                <% const date = referral.createdAt.toLocaleDateString() %>
                <% const time = referral.createdAt.toLocaleTimeString() %>
                <td><%= date %>, <%= time %></td>
                <td><span class="pill <%= referral.confirmed === true ? 'success' : 'pending' %>"><%= referral.confirmed === true ? 'Active' : 'Pending' %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="cards-list" style="padding:10px">
          <% referrals.forEach(referral => { %>
          <div class="mini-card">
            <div class="row between"><strong><%= referral.firstName %> <%= referral.lastName %></strong><span class="pill <%= referral.confirmed === true ? 'success' : 'pending' %>"><%= referral.confirmed === true ? 'Active' : 'Pending' %></span></div>
            <div class="mini-row"><span>Email</span><span><%= referral.email %></span></div>
            <% const date = referral.createdAt.toLocaleDateString() %>
            <% const time = referral.createdAt.toLocaleTimeString() %>
            <div class="mini-row"><span>Joined</span><span><%= date %>, <%= time %></span></div>
          </div>
          <% }) %>
        </div>
        <!-- <div class="pager" data-pager hidden>
          <button class="btn sm ghost" type="button" data-page-prev>Previous</button>
          <span class="muted small" data-page-info></span>
          <button class="btn sm ghost" type="button" data-page-next>Next</button>
        </div> -->
      </div>
    </div>
  </main>
</div>
<%- include('partials/dashboardFooter') %>