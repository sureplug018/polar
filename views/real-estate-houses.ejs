<%- include('partials/landingPageHeader') %>

<style>
  .property-page {
    background: #f6f4ef;
    color: #1d2927;
    font-family: Georgia, 'Times New Roman', serif;
    padding: 76px 0 96px;
  }

  .property-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .property-intro {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: end;
    margin-bottom: 44px;
  }

  .property-kicker {
    color: #b26935;
    font: 700 12px/1.2 Arial, sans-serif;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .property-intro h1 {
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 400;
    line-height: .98;
    margin: 14px 0 16px;
    max-width: 650px;
  }

  .property-intro p {
    color: #68716d;
    font: 16px/1.7 Arial, sans-serif;
    max-width: 510px;
    margin: 0;
  }

  .property-count {
    color: #68716d;
    font: 13px Arial, sans-serif;
    white-space: nowrap;
  }

  .property-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .property-card {
    background: #fff;
    box-shadow: 0 12px 34px rgba(29, 41, 39, .08);
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .property-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 42px rgba(29, 41, 39, .14);
  }

  .property-card-image {
    height: 260px;
    position: relative;
    overflow: hidden;
  }

  .property-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .property-card:hover img {
    transform: scale(1.04);
  }

  .property-status {
    background: #e9b178;
    color: #1d2927;
    font: 700 11px Arial, sans-serif;
    letter-spacing: 1px;
    padding: 8px 11px;
    position: absolute;
    left: 16px;
    top: 16px;
    text-transform: uppercase;
  }

  .property-card-copy {
    padding: 24px 24px 26px;
  }

  .property-card-copy h2 {
    font-size: 28px;
    font-weight: 400;
    margin: 0 0 6px;
  }

  .property-type,
  .property-location {
    color: #68716d;
    font: 13px Arial, sans-serif;
  }

  .property-location {
    margin: 0 0 22px;
  }

  .property-card-copy p {
    color: #52605b;
    font: 14px/1.65 Arial, sans-serif;
    min-height: 68px;
    margin: 0 0 20px;
  }

  .property-meta {
    border-top: 1px solid #e5e5df;
    border-bottom: 1px solid #e5e5df;
    display: flex;
    gap: 14px;
    padding: 14px 0;
    color: #52605b;
    font: 12px Arial, sans-serif;
  }

  .property-price {
    color: #1d2927;
    font: 700 21px Georgia, serif;
    margin: 20px 0;
  }

  .property-link {
    color: #b26935;
    font: 700 12px Arial, sans-serif;
    letter-spacing: 1.2px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .property-link:hover {
    color: #1d2927;
  }

  @media (max-width: 900px) {
    .property-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .property-page {
      padding: 52px 0 70px;
    }

    .property-intro {
      display: block;
    }

    .property-count {
      display: block;
      margin-top: 22px;
    }

    .property-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<main class="property-page">
  <div class="property-shell">
    <div class="property-intro">
      <div>
        <div class="property-kicker">Polaris property collection</div>
        <h1>Spaces with a sense of place.</h1>
        <p>Explore a considered collection of homes selected for their character, location, and long-term value.</p>
      </div>
      <div class="property-count"><%= houses.length %> residences currently available</div>
    </div>

    <div class="property-grid">
      <% houses.forEach((house) => { %>
      <article class="property-card">
        <a href="/real-estate-houses/<%= house.id %>">
          <div class="property-card-image">
            <img src="<%= house.images[0] %>" alt="<%= house.name %>">
            <span class="property-status"><%= house.status %></span>
          </div>
        </a>
        <div class="property-card-copy">
          <div class="property-type"><%= house.type %></div>
          <h2><%= house.name %></h2>
          <div class="property-location"><%= house.location %></div>
          <p><%= house.summary || house.description %></p>
          <div class="property-meta">
            <span><strong><%= house.bedrooms %></strong> beds</span>
            <span><strong><%= house.bathrooms %></strong> baths</span>
            <span><strong><%= house.area %></strong></span>
          </div>
          <div class="property-price"><%= formatCurrency(house.price) %></div>
          <a class="property-link" href="/real-estate-houses/<%= house.id %>">View residence &rarr;</a>
        </div>
      </article>
      <% }); %>
    </div>
  </div>
</main>

<%- include('partials/landingPageFooter') %>