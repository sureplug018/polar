<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Cards</h1>
    <p class="muted" style="margin:6px 0 0">Confirm or decline member cards and attach a message.</p>
  </div>
  <div class="card">
    <form method="GET">
      <div class="grid g3"><label class="field"><span>Search</span><input type="text" name="email" placeholder="Search by email..." value="<%= query.email || '' %>" /></label>
    </form>
    <!-- <label class="field"><span>Type</span>
        <select>
          <option>All types</option>
          <option>Deposit</option>
          <option>Withdrawal</option>
          <option>Profit</option>
        </select>
      </label>
      <label class="field"><span>Status</span>
        <select>
          <option>All statuses</option>
          <option>Success</option>
          <option>Pending</option>
          <option>Warning</option>
          <option>Error</option>
        </select>
      </label> -->
  </div>
  </div>
  <div class="mt">
    <div class="card table-card" data-paginate="10" id="tbl6" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Member</th>
              <th>Email</th>
              <th>Type</th>
              <th>Billing Address</th>
              <th>Zip Code</th>
              <th>Amount</th>
              <th>Wallet</th>
              <th>Address</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% cards.forEach((card, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= card.user.firstName %> <%= card.user.lastName %></td>
              <td><%= card.user.email %></td>
              <td><%= card.cardType %></td>
              <td><%= card.billingAddress %></td>
              <td><%= card.zipCode %></td>
              <td>$<%= formatCurrency(card.amount) %></td>
              <td><%= card.wallet %></td>
              <td><%= card.address || 'N/A' %></td>
              <td><span class="pill <%= card.status === 'inactive' || card.status === 'blocked' ? 'error' : card.status === 'pending' ? 'warning' : 'success' %>"><%= card.status %></span></td>
              <% const date = card.createdAt.toLocaleDateString() %>
              <% const time = card.createdAt.toLocaleTimeString() %>
              <td><%= date %>, <%= time %></td>
              <td><button class="btn sm ghost" data-card-id="<%= card._id %>" onclick="openModal('card-modal')">Manage</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% cards.forEach((card, i) => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= card.user.firstName %> <%= card.user.lastName %></strong><span class="pill <%= card.status === 'inactive' || card.status === 'blocked' ? 'error' : card.status === 'pending' ? 'warning' : 'success' %>"><%= card.status %></span></div>
          <div class="mini-row"><span><%= card.cardType %> · <%= card._id %></span><span><%= formatCurrency(card.amount) %></span></div>
          <div class="mini-row"><span>Email</span><span><%= card.user.email %></span></div>
          <div class="mini-row"><span>Billing Address</span><span><%= card.billingAddress %></span></div>
          <div class="mini-row"><span>Zip Code</span><span><%= card.zipCode %></span></div>
          <% const date = card.createdAt.toLocaleDateString() %>
          <% const time = card.createdAt.toLocaleTimeString() %>
          <div class="mini-row"><span>Date</span><span><%= date %>, <%= time %></span></div>
          <button class="btn sm block" style="margin-top:10px" data-card-id="<%= card._id %>" onclick="openModal('card-modal')">Manage</button>
        </div>
        <% }) %>

      </div>
      <%- include('partials/pagination') %>
    </div>
  </div>
  <div class="modal-backdrop" id="card-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Manage card</h3><button class="icon-btn" onclick="closeModal('card-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo>
          <div id="alert" style="margin-bottom:14px"></div>
          <!-- <label class="field"><span>Message to member</span><textarea rows="4" placeholder="Deposit confirmed after 12 network confirmations."></textarea></label> -->
          <div class="row"><button class="btn approve-btn" type="submit">Approve</button><button class="btn danger decline-btn" type="button">Decline</button>
            <div><label class="field"><span>Card Status</span>
                <select data-card-select-status>
                  <option value="">Select a card Status</option>
                  <option value="active">Active</option>
                  <option value="inactive">Inactive</option>
                  <option value="blocked">Blocked</option>
                </select></label>
              <button class="btn status-btn" type="submit">Update Status</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>
<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
  const cardModal = document.getElementById('card-modal');
  const approveBtn = cardModal.querySelector('.approve-btn');
  const declineBtn = cardModal.querySelector('.decline-btn');
  const statusBtn = cardModal.querySelector('.status-btn');
  const cardSelectStatus = cardModal.querySelector('[data-card-select-status]');
  const selectedStatus = cardSelectStatus.value;
  const cardButtons = document.querySelectorAll('button[data-card-id]');
  let currentCardId = null;

  // Reset buttons when modal is opened
  function resetButtons() {
    approveBtn.disabled = false;
    declineBtn.disabled = false;
    approveBtn.style.cursor = '';
    declineBtn.style.cursor = '';
    approveBtn.textContent = 'Approve';
    declineBtn.textContent = 'Decline';
  }

  cardButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentCardId = button.getAttribute('data-card-id');
      resetButtons();
      openModal('card-modal');
    });
  });

  function setProcessingState(clickedBtn) {
    approveBtn.disabled = true;
    declineBtn.disabled = true;
    approveBtn.style.cursor = 'not-allowed';
    declineBtn.style.cursor = 'not-allowed';
    clickedBtn.textContent = 'Processing...';
  }

  // Approve handler
  approveBtn.addEventListener('click', async () => {
    if (!currentCardId) {
      showAlert('error', 'Action not allowed', 'Card ID is missing.');
      return;
    }

    setProcessingState(approveBtn);

    try {
      const response = await axios.post(`/api/v1/cards/approve-card/${currentCardId}`);
      if (response.data.status === 'success') {
        showAlert('success', 'Card approved successfully', 'The member has been notified by email.');
        setTimeout(() => {
          closeModal('card-modal');
          location.reload();
        }, 2000);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      resetButtons();
    }
  });

  // Decline handler
  declineBtn.addEventListener('click', async () => {
    if (!currentCardId) {
      showAlert('error', 'Action not allowed', 'Card ID is missing.');
      return;
    }

    setProcessingState(declineBtn);

    try {
      const response = await axios.post(`/api/v1/cards/decline-card/${currentCardId}`);
      if (response.data.status === 'success') {
        showAlert('success', 'Card declined successfully', 'The member has been notified by email.');
        setTimeout(() => {
          closeModal('card-modal');
          location.reload();
        }, 2000);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      resetButtons();
    }
  });

  // Update status handler
  statusBtn.addEventListener('click', async (e) => {
    e.preventDefault();
    if (!currentCardId) {
      showAlert('error', 'Action not allowed', 'Card ID is missing.');
      return;
    }
    const selectedStatus = cardSelectStatus.value;
    if (!selectedStatus) {
      showAlert('error', 'Action not allowed', 'Please select a status.');
      return;
    }
    setProcessingState(statusBtn);

    try {
      const response = await axios.patch(`/api/v1/cards/update-card-status/${currentCardId}`, {
        status: selectedStatus
      });
      if (response.data.status === 'success') {
        showAlert('success', 'Card status updated successfully', 'The member has been notified by email.');
        setTimeout(() => {
          closeModal('card-modal');
          location.reload();
        }, 2000);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      resetButtons();
    }
  });
</script>
<%- include('partials/adminFooter') %>