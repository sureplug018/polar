<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Transactions</h1>
    <p class="muted" style="margin:6px 0 0">Confirm or decline member transactions and attach a message.</p>
  </div>
  <div class="card">
    <form method="GET">
      <div class="grid g3"><label class="field"><span>Search</span><input type="text" name="email" placeholder="Search by email..." value="<%= query.email || '' %>" /></label>
    </form>
    <!-- <label class="field"><span>Type</span>
        <select>
          <option>All types</option>
          <option>Deposit</option>
          <option>Withdrawal</option>
          <option>Profit</option>
        </select>
      </label>
      <label class="field"><span>Status</span>
        <select>
          <option>All statuses</option>
          <option>Success</option>
          <option>Pending</option>
          <option>Warning</option>
          <option>Error</option>
        </select>
      </label> -->
  </div>
  </div>
  <div class="mt">
    <div class="card table-card" data-paginate="10" id="tbl6" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Member</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Wallet</th>
              <th>Address</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach((transaction, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= transaction.user.firstName %> <%= transaction.user.lastName %></td>
              <td><%= transaction.type %></td>
              <td><%= formatCurrency(transaction.amount) %></td>
              <td><%= transaction.wallet %></td>
              <td><%= transaction.address || 'N/A' %></td>
              <td><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></td>
              <% const date = transaction.createdAt.toLocaleDateString() %>
              <% const time = transaction.createdAt.toLocaleTimeString() %>
              <td><%= date %>, <%= time %></td>
              <td><button class="btn sm ghost" onclick="openModal('tx-modal')">Manage</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% transactions.forEach((transaction, i) => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= transaction.user.firstName %> <%= transaction.user.lastName %></strong><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></div>
          <div class="mini-row"><span><%= transaction.type %> · <%= transaction._id %></span><span><%= formatCurrency(transaction.amount) %></span></div>
          <% const date = transaction.createdAt.toLocaleDateString() %>
          <% const time = transaction.createdAt.toLocaleTimeString() %>
          <div class="mini-row"><span>Date</span><span><%= date %>, <%= time %></span></div>
          <button class="btn sm block" style="margin-top:10px" onclick="openModal('tx-modal')">Manage</button>
        </div>
        <% }) %>

      </div>
      <%- include('partials/pagination') %>
    </div>
  </div>
  <div class="modal-backdrop" id="tx-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Manage transaction</h3><button class="icon-btn" onclick="closeModal('tx-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo>
          <label class="field"><span>Message to member</span><textarea rows="4" placeholder="Deposit confirmed after 12 network confirmations."></textarea></label>
          <div class="row"><button class="btn" type="submit">Approve</button><button class="btn danger" type="button" onclick="closeModal('tx-modal')">Decline</button></div>
          <div class="alert success mt" data-demo-note style="display:none">
            <h4>Transaction updated</h4>
            <p style="margin:0">The member has been notified by email.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>
<%- include('partials/adminFooter') %>