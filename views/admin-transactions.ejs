<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Transactions</h1>
    <p class="muted" style="margin:6px 0 0">Confirm or decline member transactions and attach a message.</p>
  </div>
  <div class="card">
    <form method="GET">
      <div class="grid g3"><label class="field"><span>Search</span><input type="text" name="email" placeholder="Search by email..." value="<%= query.email || '' %>" /></label>
    </form>
    <!-- <label class="field"><span>Type</span>
        <select>
          <option>All types</option>
          <option>Deposit</option>
          <option>Withdrawal</option>
          <option>Profit</option>
        </select>
      </label>
      <label class="field"><span>Status</span>
        <select>
          <option>All statuses</option>
          <option>Success</option>
          <option>Pending</option>
          <option>Warning</option>
          <option>Error</option>
        </select>
      </label> -->
  </div>
  </div>
  <div class="mt">
    <div class="card table-card" data-paginate="10" id="tbl6" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Member</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Wallet</th>
              <th>Address</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach((transaction, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= transaction.user.firstName %> <%= transaction.user.lastName %></td>
              <td><%= transaction.type %></td>
              <td><%= formatCurrency(transaction.amount) %></td>
              <td><%= transaction.wallet %></td>
              <td><%= transaction.address || 'N/A' %></td>
              <td><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></td>
              <% const date = transaction.createdAt.toLocaleDateString() %>
              <% const time = transaction.createdAt.toLocaleTimeString() %>
              <td><%= date %>, <%= time %></td>
              <td><button class="btn sm ghost" data-transaction-id="<%= transaction._id %>" onclick="openModal('tx-modal')">Manage</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% transactions.forEach((transaction, i) => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= transaction.user.firstName %> <%= transaction.user.lastName %></strong><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></div>
          <div class="mini-row"><span><%= transaction.type %> · <%= transaction._id %></span><span><%= formatCurrency(transaction.amount) %></span></div>
          <% const date = transaction.createdAt.toLocaleDateString() %>
          <% const time = transaction.createdAt.toLocaleTimeString() %>
          <div class="mini-row"><span>Date</span><span><%= date %>, <%= time %></span></div>
          <button class="btn sm block" style="margin-top:10px" data-transaction-id="<%= transaction._id %>" onclick="openModal('tx-modal')">Manage</button>
        </div>
        <% }) %>

      </div>
      <%- include('partials/pagination') %>
    </div>
  </div>
  <div class="modal-backdrop" id="tx-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Manage transaction</h3><button class="icon-btn" onclick="closeModal('tx-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo>
          <div id="alert" style="margin-bottom:14px"></div>
          <!-- <label class="field"><span>Message to member</span><textarea rows="4" placeholder="Deposit confirmed after 12 network confirmations."></textarea></label> -->
          <div class="row"><button class="btn approve-btn" type="submit">Approve</button><button class="btn danger decline-btn" type="button">Decline</button></div>
        </form>
      </div>
    </div>
  </div>
</main>
<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
  const txModal = document.getElementById('tx-modal');
  const approveBtn = txModal.querySelector('.approve-btn');
  const declineBtn = txModal.querySelector('.decline-btn');
  const txButtons = document.querySelectorAll('button[data-transaction-id]');
  let currentTransactionId = null;

  // Reset buttons when modal is opened
  function resetButtons() {
    approveBtn.disabled = false;
    declineBtn.disabled = false;
    approveBtn.style.cursor = '';
    declineBtn.style.cursor = '';
    approveBtn.textContent = 'Approve';
    declineBtn.textContent = 'Decline';
  }

  txButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentTransactionId = button.getAttribute('data-transaction-id');
      resetButtons();
      openModal('tx-modal');
    });
  });

  function setProcessingState(clickedBtn) {
    approveBtn.disabled = true;
    declineBtn.disabled = true;
    approveBtn.style.cursor = 'not-allowed';
    declineBtn.style.cursor = 'not-allowed';
    clickedBtn.textContent = 'Processing...';
  }

  // Approve handler
  approveBtn.addEventListener('click', async () => {
    if (!currentTransactionId) {
      showAlert('error', 'Action not allowed', 'Transaction ID is missing.');
      return;
    }

    setProcessingState(approveBtn);

    try {
      const response = await axios.patch(`/api/v1/transactions/confirm-transaction/${currentTransactionId}`);
      if (response.data.status === 'success') {
        showAlert('success', 'Transaction approved successfully', 'The member has been notified by email.');
        setTimeout(() => {
          closeModal('tx-modal');
          location.reload();
        }, 2000);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      resetButtons();
    }
  });

  // Decline handler
  declineBtn.addEventListener('click', async () => {
    if (!currentTransactionId) {
      showAlert('error', 'Action not allowed', 'Transaction ID is missing.');
      return;
    }

    setProcessingState(declineBtn);

    try {
      const response = await axios.patch(`/api/v1/transactions/decline-transaction/${currentTransactionId}`);
      if (response.data.status === 'success') {
        showAlert('success', 'Transaction declined successfully', 'The member has been notified by email.');
        setTimeout(() => {
          closeModal('tx-modal');
          location.reload();
        }, 2000);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      resetButtons();
    }
  });
</script>
<%- include('partials/adminFooter') %>