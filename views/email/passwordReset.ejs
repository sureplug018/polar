<!doctype html>
<html>

<head>
  <meta name="viewport" content="width=device-width" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>
    <%= subject %>
  </title>

  <%- include('styles/_style') %>
</head>

<body>
  <table class="body" role="presentation" border="0" cellpadding="0" cellspacing="0">
    <tbody>
      <tr>
        <td></td>
        <td class="container">
          <div class="content">
            <p style="text-align: center;">
              <img style="padding-top: 20px;" src="https://evergreenwealthsolutions.ltd/assets/images/banner.jpeg" alt="" width="100%" style="height: auto;" />
            </p>
            <!-- Rest of your HTML content -->
            <p>Hello <%= firstName %>,</p>
            <p>Forgot your password? Submit a PATCH with your new password and passwordConfirm to: <%= url %>
            </p>
            <p>
              Please, don't click this link if you don't want to change your password
            </p>
            <table class="btn btn-primary" role="presentation" border="0" cellpadding="0" cellspacing="0">
              <tbody>
                <tr>
                  <td align="left">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                      <tbody>
                        <tr>
                          <td>
                            <a href="<%= url %>" target="_blank">Reset your password</a>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</body>

</html>