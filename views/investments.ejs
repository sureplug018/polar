<%- include('partials/dashboardHeader') %>
<div class="content">
  <%- include('partials/dashboardHead') %>
  <main class="page">

    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">My investments</h1>
      <p class="muted" style="margin:6px 0 0">Running and completed plans with profit tracking.</p>
    </div>
    <div class="grid g4">
      <div class="card stat featured">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Active capital</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12a7 7 0 0 1 7-7h3a7 7 0 0 1 7 7v3a3 3 0 0 1-3 3h-1l-1 2h-3l-1-2H7a3 3 0 0 1-3-3Z" />
              <circle cx="9" cy="12" r="1" />
            </svg></span>
        </div>
        <p class="stat-value">$15,200.00</p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Profit earned</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 16 5-5 4 4 8-8" />
              <path d="M20 7v5h-5" />
            </svg></span>
        </div>
        <p class="stat-value">$6,250.42</p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Completed plans</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="6" width="18" height="13" rx="3" />
              <path d="M3 10h18" />
              <circle cx="17" cy="14" r="1.4" />
            </svg></span>
        </div>
        <p class="stat-value">1</p>
      </div>
    </div>
    <div class="mt">
      <div class="card table-card" data-paginate="10" id="tbl3" style="padding:6px">
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>ID</th>
                <th>Plan</th>
                <th>Amount</th>
                <th>Profit</th>
                <th>Status</th>
                <th>Started</th>
                <th>Ends</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>IV-3391</td>
                <td>Growth</td>
                <td>$7,500.00</td>
                <td>$1,875.00</td>
                <td><span class="pill success">success</span></td>
                <td>24 Jul 2026</td>
                <td>24 Aug 2026</td>
              </tr>
              <tr>
                <td>IV-3350</td>
                <td>Starter</td>
                <td>$1,200.00</td>
                <td>$168.00</td>
                <td><span class="pill success">success</span></td>
                <td>01 Aug 2026</td>
                <td>15 Aug 2026</td>
              </tr>
              <tr>
                <td>IV-3288</td>
                <td>Premium</td>
                <td>$15,000.00</td>
                <td>$5,400.00</td>
                <td><span class="pill pending">pending</span></td>
                <td>12 May 2026</td>
                <td>12 Jul 2026</td>
              </tr>
              <tr>
                <td>IV-3204</td>
                <td>Growth</td>
                <td>$4,000.00</td>
                <td>$0.00</td>
                <td><span class="pill error">error</span></td>
                <td>02 Apr 2026</td>
                <td>02 May 2026</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="cards-list" style="padding:10px">
          <div class="mini-card">
            <div class="row between"><strong>Growth</strong><span class="pill success">success</span></div>
            <div class="mini-row"><span>Amount</span><span>$7,500.00</span></div>
            <div class="mini-row"><span>Profit</span><span>$1,875.00</span></div>
            <div class="mini-row"><span>Window</span><span>24 Jul 2026 → 24 Aug 2026</span></div>
          </div>
          <div class="mini-card">
            <div class="row between"><strong>Starter</strong><span class="pill success">success</span></div>
            <div class="mini-row"><span>Amount</span><span>$1,200.00</span></div>
            <div class="mini-row"><span>Profit</span><span>$168.00</span></div>
            <div class="mini-row"><span>Window</span><span>01 Aug 2026 → 15 Aug 2026</span></div>
          </div>
          <div class="mini-card">
            <div class="row between"><strong>Premium</strong><span class="pill pending">pending</span></div>
            <div class="mini-row"><span>Amount</span><span>$15,000.00</span></div>
            <div class="mini-row"><span>Profit</span><span>$5,400.00</span></div>
            <div class="mini-row"><span>Window</span><span>12 May 2026 → 12 Jul 2026</span></div>
          </div>
          <div class="mini-card">
            <div class="row between"><strong>Growth</strong><span class="pill error">error</span></div>
            <div class="mini-row"><span>Amount</span><span>$4,000.00</span></div>
            <div class="mini-row"><span>Profit</span><span>$0.00</span></div>
            <div class="mini-row"><span>Window</span><span>02 Apr 2026 → 02 May 2026</span></div>
          </div>
        </div>
        <div class="pager" data-pager hidden>
          <button class="btn sm ghost" type="button" data-page-prev>Previous</button>
          <span class="muted small" data-page-info></span>
          <button class="btn sm ghost" type="button" data-page-next>Next</button>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/dashboardFooter') %>