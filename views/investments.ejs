<%- include('partials/dashboardHeader') %>
<div class="content">
  <%- include('partials/dashboardHead') %>
  <main class="page">

    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">My investments</h1>
      <p class="muted" style="margin:6px 0 0">Running and completed plans with profit tracking.</p>
    </div>
    <div class="grid g4">
      <div class="card stat featured">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Total Investments</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12a7 7 0 0 1 7-7h3a7 7 0 0 1 7 7v3a3 3 0 0 1-3 3h-1l-1 2h-3l-1-2H7a3 3 0 0 1-3-3Z" />
              <circle cx="9" cy="12" r="1" />
            </svg></span>
        </div>
        <p class="stat-value">$<%= formatCurrency(totalInvestments) %></p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Profit earned</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 16 5-5 4 4 8-8" />
              <path d="M20 7v5h-5" />
            </svg></span>
        </div>
        <p class="stat-value">$<%= formatCurrency(completedInvestments.reduce((total, investment) => total + (investment.plan.roi * investment.plan.duration)/ 100 * investment.amount, 0)) %></p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Completed plans</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="6" width="18" height="13" rx="3" />
              <path d="M3 10h18" />
              <circle cx="17" cy="14" r="1.4" />
            </svg></span>
        </div>
        <p class="stat-value"><%= completedInvestments.length.toLocaleString() %></p>
      </div>
    </div>
    <div class="mt">
      <div class="card table-card" data-paginate="10" id="tbl3" style="padding:6px">
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>ID</th>
                <th>Plan</th>
                <th>Amount</th>
                <th>Profit</th>
                <th>Status</th>
                <th>TimeStamp</th>
              </tr>
            </thead>
            <tbody>
              <% investments.forEach((investment, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= investment.plan.name %></td>
                <td>$<%= formatCurrency(investment.amount) %></td>
                <td><%= investment.plan.roi %>%</td>
                <td><span class="pill <%= investment.status === 'active' ? 'warning' : 'success' %>"><%= investment.status === 'active' ? 'Active' : 'Completed' %></span></td>
                <% const date = investment.createdAt.toLocaleDateString() %>
                <% const time = investment.createdAt.toLocaleTimeString() %>
                <td><%= date %>, <%= time %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="cards-list" style="padding:10px">
          <% investments.forEach(investment => { %>
          <div class="mini-card">
            <div class="row between"><strong><%= investment.plan.name %></strong><span class="pill <%= investment.status === 'active' ? 'warning' : 'success' %>"><%= investment.status === 'active' ? 'Active' : 'Completed' %></span></div>
            <div class="mini-row"><span>Amount</span><span>$<%= formatCurrency(investment.amount) %></span></div>
            <div class="mini-row"><span>Profit</span><span><%= formatCurrency(investment.plan.roi) %>%</span></div>
            <% const date = investment.createdAt.toLocaleDateString() %>
            <% const time = investment.createdAt.toLocaleTimeString() %>
            <div class="mini-row"><span>Window</span><span><%= date %> → <%= date %></span></div>
          </div>
          <% }) %>
        </div>
        <div class="pager" data-pager hidden>
          <button class="btn sm ghost" type="button" data-page-prev>Previous</button>
          <span class="muted small" data-page-info></span>
          <button class="btn sm ghost" type="button" data-page-next>Next</button>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/dashboardFooter') %>