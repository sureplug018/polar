<%- include('partials/landingPageHeader') %>
<!-- xxx Header End xxx -->

<!-- xxx Page Hero xxx -->
<section class="pf-detail-hero">
  <div class="pf-detail-hero-bg" style="background-image: url('/assets/home/images/cloud-mining-farm.jpg');"></div>
  <div class="container">
    <ul class="pf-crumbs">
      <li><a href="/"><i class="icofont icofont-home"></i> Home</a></li>
      <li><a href="/services">Services</a></li>
      <li>Cloud Mining</li>
    </ul>
    <h1>Cloud Mining</h1>
    <p><%= description %></p>
    <div class="pf-detail-hero-actions">
      <a href="/register" class="pf-btn">Start Mining</a>
      <a href="#mining-hardware" class="pf-btn is-ghost">View Mining Machines</a>
    </div>
  </div>
</section>
<!-- xxx Page Hero End xxx -->

<div id="body-content">
  <section class="pf-detail">
    <div class="container">
      <div class="row">

        <div class="col-lg-8 col-12">
          <figure class="pf-detail-figure">
            <img src="/assets/home/images/cloud-mining-facility.jpg" alt="Rows of ASIC miners in a cloud mining hosting facility">
          </figure>

          <h2>Cloud Mining with Polaris</h2>
          <p class="pf-lead">At Polaris Finance, we make cloud mining accessible by giving clients direct exposure to industrial-scale cryptocurrency mining. You rent hash power from machines we own and operate, and the output they generate is credited to your account — without the complexity of owning or maintaining hardware.</p>

          <p>Cloud mining provides unique opportunities for portfolio growth by generating mining rewards through rented computing power. It offers 24/7 income potential, lower operational barriers compared to traditional mining, and diversification benefits within the broader digital asset ecosystem.</p>

          <p>Our hosting floors run latest-generation Bitmain Antminer and MicroBT Whatsminer units on industrial power contracts, with redundant cooling and on-site engineers around the clock. Every contract comes with transparent terms, secure payouts and clear performance reporting so you can invest with confidence.</p>

          <div class="pf-detail-block">
            <h3>Live from our mining floor</h3>
            <p>Hash power from every machine on the floor is pointed at the Polaris pool. The figures below update in real time as shares are submitted to the network.</p>
            <%- include('partials/miningScene', { sceneClass: 'is-tall' }) %>
          </div>

          <div class="pf-detail-block">
            <h3>How cloud mining works</h3>
            <div class="pf-flow">
              <div class="pf-flow-step">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="1.5"></rect><rect x="3" y="13" width="18" height="7" rx="1.5"></rect><path d="M7 7.5h.01M7 16.5h.01"></path></svg>
                <strong>Choose a machine</strong>
                Pick hardware by grade and budget.
              </div>
              <div class="pf-flow-step">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9z"></path></svg>
                <strong>We power it</strong>
                Hosted, cooled and maintained by us.
              </div>
              <div class="pf-flow-step">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 9.5a4 4 0 0 1-1 7.9"></path><path d="M12 12v8M9 17l3 3 3-3"></path></svg>
                <strong>Hash to the pool</strong>
                Your share of hash power mines 24/7.
              </div>
              <div class="pf-flow-step">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20M6 15h4"></path></svg>
                <strong>Get paid daily</strong>
                Output credited to your dashboard.
              </div>
            </div>
          </div>

          <div class="pf-detail-block">
            <h3>Why invest in Cloud Mining with Polaris?</h3>
            <p>Our thesis is straightforward: cloud mining allows investors to earn cryptocurrency rewards without the capital intensity, technical expertise, or energy costs of traditional mining. When approached with proper due diligence and risk management, it can serve as a powerful income-generating component within a well-diversified portfolio.</p>
          </div>

          <div class="pf-detail-block">
            <h3>Key risks to consider</h3>
            <ul class="pf-risks">
              <li>Fluctuations in cryptocurrency prices and mining difficulty</li>
              <li>Provider reliability and contract terms</li>
              <li>Network hash-rate changes affecting profitability</li>
              <li>Regulatory and operational risks of mining platforms</li>
            </ul>
          </div>

          <div class="pf-detail-block">
            <h3>How to Invest</h3>
            <p><strong>From onboarding to allocation in minutes</strong></p>
            <ol class="pf-steps">
              <li><strong>Open your account</strong>Complete identity verification and securely link your funding source.</li>
              <li><strong>Choose your machine</strong>Select a mining machine by grade, or allocate a percentage of your portfolio to the Cloud Mining sleeve.</li>
              <li><strong>Track performance</strong>Monitor mining rewards, contract status, and overall returns in real time through your Polaris dashboard.</li>
            </ol>
          </div>
        </div>

        <div class="col-lg-4 col-12">
          <%- include('partials/serviceSidebar', { activeService: 'cloud-mining' }) %>
        </div>

      </div>
    </div>
  </section>

  <!-- xxx Mining Hardware xxx -->
  <section class="pf-hardware" id="mining-hardware">
    <div class="container">
      <div class="pf-heading">
        <span class="pf-eyebrow">Mining hardware</span>
        <h2>Mining Machines &amp; Prices by Grade</h2>
        <p>Every machine is installed, powered and maintained in our hosting facility. Choose a grade that matches your budget and output goals.</p>
      </div>

      <div class="pf-grade-tabs" role="tablist" aria-label="Mining machine grades">
        <% miningGrades.forEach((group, i) => { %>
        <button type="button" role="tab" class="pf-grade-tab <%= i === 0 ? 'is-active' : '' %>" id="grade-tab-<%= i %>" aria-controls="grade-panel-<%= i %>" aria-selected="<%= i === 0 %>">
          <%= group.grade %><span><%= group.tier %></span>
        </button>
        <% }) %>
      </div>

      <% miningGrades.forEach((group, i) => { %>
      <div class="pf-grade-panel" id="grade-panel-<%= i %>" role="tabpanel" aria-labelledby="grade-tab-<%= i %>" <%= i === 0 ? '' : 'hidden' %>>
        <p class="pf-grade-summary"><%= group.summary %></p>
        <div class="pf-machines">
          <% group.machines.forEach((machine) => { %>
          <article class="pf-machine">
            <div class="pf-machine-media">
              <img src="/assets/home/images/mining-machines.jpg" alt="<%= machine.name %>" loading="lazy">
              <span class="pf-machine-grade"><%= group.grade %></span>
              <span class="pf-machine-status">In stock</span>
            </div>
            <div class="pf-machine-body">
              <h4><%= machine.name %></h4>
              <span class="pf-machine-algo"><%= machine.algorithm %> &middot; Mines <%= machine.coin %></span>
              <dl class="pf-machine-specs">
                <div><dt>Hashrate</dt><dd><%= machine.hashrate %></dd></div>
                <div><dt>Power</dt><dd><%= machine.power %></dd></div>
                <div><dt>Efficiency</dt><dd><%= machine.efficiency %></dd></div>
              </dl>
              <div class="pf-machine-foot">
                <div class="pf-machine-price">
                  <small>Price</small>
                  <strong><%= formatMoney(machine.price) %></strong>
                </div>
                <a href="/register" class="pf-btn">Buy Now</a>
              </div>
            </div>
          </article>
          <% }) %>
        </div>
      </div>
      <% }) %>

      <p class="pf-hardware-note">Prices include installation and the first month of hosting. Availability is limited and prices may change with hardware market conditions.</p>
    </div>
  </section>
  <!-- xxx Mining Hardware End xxx -->

  <section class="pf-detail" style="padding-top: 0; background: var(--pf-soft);">
    <div class="container">
      <div class="pf-cta-band" style="margin-top: 0;">
        <div>
          <h3>Ready to grow your wealth with Polaris Finance?</h3>
          <p>Join investors building diversified portfolios across high-performing sectors — including cloud mining.</p>
        </div>
        <a href="/register" class="pf-btn">Get Started <i class="icofont-rounded-right"></i></a>
      </div>
      <p class="mt-4 mb-0 text-center" style="font-size: .72rem; color: #98a1ae;">
        Photos: “Bitcoin mining farm” by Marko Ahtisaari (CC BY 2.0); “Argo Blockchain Mirabel Facility” by MikeBogosian (CC BY-SA 4.0); “Canaan AvalonMiner A10” by Canaan (CC BY-SA 4.0); “Hut 8 Medicine Hat” by Curtis Huisman (CC BY 4.0), via Wikimedia Commons.
      </p>
    </div>
  </section>
</div>

<%- include('partials/landingPageFooter') %>
