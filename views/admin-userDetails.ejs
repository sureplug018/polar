<script>
  const editMessageModalButton = document.querySelectorAll('.edit-message-modal-button');

  let messageId;
  if (editMessageModalButton) {
    editMessageModalButton.forEach(button => {
      button.addEventListener('click', function() {
        messageId = this.dataset.messageId;
      });
    });
  }

  const editMessageForm = document.querySelector('.edit-message-form');
  if (editMessageForm) {
    // Existing edit/save handler
    editMessageForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = document.querySelector('.edit-message-btn');
      submitBtn.disabled = true;
      submitBtn.style.cursor = 'not-allowed';
      submitBtn.textContent = 'Saving...';

      const title = document.getElementById('edit-message-title').value;
      const message = document.getElementById('edit-message').value;
      const status = document.getElementById('edit-message-status').value;

      if (!messageId) {
        return showAlert('error', 'Message update error', 'Message ID is required');
      }

      try {
        const response = await axios.patch(`/api/v1/messages/edit-message/${messageId}`, {
          title,
          message,
          status
        });

        if (response.data.status === 'success') {
          showAlert('success', 'Message updated.', 'You have successfully updated a message');
          window.setTimeout(() => {
            editMessageForm.reset();
            closeModal('edit-message-modal');
          }, 2000);
        }
      } catch (error) {
        showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.cursor = 'pointer';
        submitBtn.textContent = 'Save message';
      }
    });
  }

  // Delete handler
  const deleteBtn = document.querySelector('.delete-message-btn');
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      if (!messageId) {
        return showAlert('error', 'Delete error', 'Message ID is required');
      }

      // Optional confirmation
      if (!confirm('Are you sure you want to delete this message?')) {
        return;
      }

      deleteBtn.disabled = true;
      deleteBtn.style.cursor = 'not-allowed';
      deleteBtn.textContent = 'Deleting...';

      try {
        // Adjust the endpoint if your backend uses a different path
        const response = await axios.delete(`/api/v1/messages/delete-message/${messageId}`);

        if (response.data.status === 'success') {
          showAlert('success', 'Message deleted.', 'You have successfully deleted the message');
          window.setTimeout(() => {
            editMessageForm?.reset();
            closeModal('edit-message-modal');
            // Optional: refresh the list or remove the row from the table
            location.reload(); // or better: remove the specific row
          }, 1500);
        }
      } catch (error) {
        showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      } finally {
        deleteBtn.disabled = false;
        deleteBtn.style.cursor = 'pointer';
        deleteBtn.textContent = 'Delete';
      }
    });
  }
</script>

