<%- include('partials/adminHeader') %>
<main class="page">
  <a class="back-link" href="/admin/users"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5" />
      <path d="m11 18-6-6 6-6" />
    </svg><span>Back to members</span></a>
  <div style="margin-bottom:18px">
    <h1 style="font-size:24px"><%= userDetail.firstName %> <%= userDetail.lastName %></h1>
    <p class="muted" style="margin:6px 0 0"><%= userDetail.myReferralCode %> · <%= userDetail.email %> · <%= userDetail.country %> · <%= userDetail.createdAt.toLocaleDateString() %></p>
  </div>
  <div class="grid g4">
    <div class="card stat featured">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Balance</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="6" width="18" height="13" rx="3" />
            <path d="M16 12.5h3" />
          </svg></span>
      </div>
      <p class="stat-value">$<%= formatCurrency(userDetail.balance) %></p>
      <p class="muted small" style="margin:6px 0 0">Available to withdraw</p>
    </div>
    <div class="card stat">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Profit</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12a7 7 0 0 1 7-7h3a7 7 0 0 1 7 7v3a3 3 0 0 1-3 3h-1l-1 2h-3l-1-2H7a3 3 0 0 1-3-3Z" />
            <circle cx="9" cy="12" r="1" />
          </svg></span>
      </div>
      <p class="stat-value">$<%= formatCurrency(userDetail.profit) %></p>
      <p class="muted small" style="margin:6px 0 0">Capital in plans</p>
    </div>
    <div class="card stat">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Total Deposits</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" />
            <circle cx="9.5" cy="8" r="3.2" />
            <path d="M18 8.5h4" />
            <path d="M20 6.5v4" />
          </svg></span>
      </div>
      <% let totalDeposits = 0 %>
      <% deposits.forEach(deposit => { %>
      <% totalDeposits += deposit.amount %>
      <% }) %>
      <p class="stat-value">$<%= formatCurrency(totalDeposits) %></p>
      <p class="muted small" style="margin:6px 0 0">All deposits</p>
    </div>
    <div class="card stat">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Total Investments</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 3 8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6Z" />
            <path d="m9 12 2 2 4-4" />
          </svg></span>
      </div>
      <% let totalInvestments = 0 %>
      <% investments.forEach(investment => { %>
      <% totalInvestments += investment.amount %>
      <% }) %>
      <p class="stat-value">$<%= formatCurrency(totalInvestments) %></p>
      <p class="muted small" style="margin:6px 0 0">All investments</p>
    </div>
  </div>

  <div class="row between" style="margin-top:30px;align-items:flex-end">
    <h2 class="section-title">On Screen Message</h2><button class="btn sm" onclick="openModal('add-message-modal')">Add message</button>
  </div>
  <div class="mt-sm">
    <% if(message){ %>
    <div class="card table-card" data-paginate="10" id="tbl24" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>Title</th>
              <th>Message</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><%= message.title %></td>
              <td><%= message.message %></td>
              <td><span class="pill <%= message.status %>"><%= message.status %></span></td>
              <td><button class="btn sm ghost edit-message-modal-button" data-message-id="<%= message._id %>" onclick="openModal('edit-message-modal')">Edit</button></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <div class="mini-card">
          <div class="row between"><strong><%= message.title %></strong><span class="pill <%= message.status %>"><%= message.status %></span></div>
          <p class="muted small" style="word-break:break-all;margin:8px 0 0"><%= message.message %></p>
          <button class="btn sm block edit-message-modal-button" data-message-id="<%= message._id %>" style="margin-top:10px" onclick="openModal('edit-message-modal')">Edit</button>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <div class="modal-backdrop" id="add-message-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Message details</h3><button class="icon-btn" onclick="closeModal('add-message-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo class="add-message-form">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>Title</span><input id="add-message-title" type="text" placeholder="Deposit Error" /></label>
          <label class="field"><span>Message</span><input id="add-message" type="text" placeholder="Enter your message" /></label>
          <label class="field"><span>Status</span>
            <select id="add-message-status">
              <option value="success">Success</option>
              <option value="warning">Warning</option>
              <option value="error">Error</option>
            </select>
          </label>
          <div class="row">
            <button class="btn add-message-btn" type="submit">Save message</button>
            <button class="btn danger" type="button" onclick="closeModal('edit-message-modal')">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop" id="edit-message-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Message details</h3><button class="icon-btn" onclick="closeModal('edit-message-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo class="edit-message-form">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>Title</span><input id="edit-message-title" type="text" placeholder="Deposit Error" /></label>
          <label class="field"><span>Message</span><input id="edit-message" type="text" placeholder="Enter your message" /></label>
          <label class="field"><span>Status</span>
            <select id="edit-message-status">
              <option value="">Select Status</option>
              <option value="success">Success</option>
              <option value="warning">Warning</option>
              <option value="error">Error</option>
            </select>
          </label>
          <div class="row">
            <button class="btn edit-message-btn" type="submit">Save message</button>
            <button class="btn danger delete-message-btn" type="button">Delete</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <h2 class="section-title mt">Account details</h2>
  <div class="card mt-sm">
    <form data-demo class="user-form" data-user-id="<%= userDetail._id %>">
      <div id="alert" style="margin-bottom:14px"></div>
      <div class="grid g2-md"><label class="field"><span>First name</span><input name="firstName" value="<%= userDetail.firstName %>" /></label><label class="field"><span>Last name</span><input name="lastName" value="<%= userDetail.lastName %>" /></label></div>
      <div class="grid g2-md"><label class="field"><span>Balance (USD)</span><input type="number" value="<%= userDetail.balance %>" /></label><label class="field"><span>Email</span><input name="email" value="<%= userDetail.email %>" /></label></div>
      <div class="grid g2-md">
        <label class="field"><span>Phone Number</span><input name="phoneNumber" type="text" value="<%= userDetail.phoneNumber %>" /></label>
        <label class="field">
          <span>Account status</span>
          <select name="status">
            <option value="true" <%= userDetail.status === true ? 'selected' : '' %>>Active</option>
            <option value="false" <%= userDetail.status === false ? 'selected' : '' %>>Disable</option>
          </select>
        </label>
      </div>
      <div class="row">
        <button class="btn update-btn" type="submit">Save member details</button>
        <!-- <button class="btn ghost" type="button">Reset password</button> -->
      </div>
    </form>
  </div>

  <div class="row between mt">
    <h2 class="section-title">Transactions</h2><a href="/admin/transactions?email=<%= userDetail.email %>" style="color:var(--primary);font-weight:700" class="small">View all</a>
  </div>
  <p class="muted small" style="margin:4px 0 0">Every deposit, withdrawal and payout for this member.</p>
  <div class="mt-sm">
    <div class="card table-card" data-paginate="10" id="tbl21" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Member</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Wallet</th>
              <th>Address</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach((transaction, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= transaction.user.firstName %> <%= transaction.user.lastName %></td>
              <td><%= transaction.type %></td>
              <td><%= formatCurrency(transaction.amount) %></td>
              <td><%= transaction.wallet %></td>
              <td><%= transaction.address || 'N/A' %></td>
              <td><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></td>
              <% const date = transaction.createdAt.toLocaleDateString() %>
              <% const time = transaction.createdAt.toLocaleTimeString() %>
              <td><%= date %>, <%= time %></td>
              <td><button class="btn sm ghost" data-transaction-id="<%= transaction._id %>" onclick="openModal('tx-modal')">Manage</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% transactions.forEach((transaction, i) => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= transaction.user.firstName %> <%= transaction.user.lastName %></strong><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></div>
          <div class="mini-row"><span><%= transaction.type %> · <%= transaction._id %></span><span><%= formatCurrency(transaction.amount) %></span></div>
          <% const date = transaction.createdAt.toLocaleDateString() %>
          <% const time = transaction.createdAt.toLocaleTimeString() %>
          <div class="mini-row"><span>Date</span><span><%= date %>, <%= time %></span></div>
          <button class="btn sm block" style="margin-top:10px" data-transaction-id="<%= transaction._id %>" onclick="openModal('tx-modal')">Manage</button>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="tx-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Manage transaction</h3><button class="icon-btn" onclick="closeModal('tx-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo>
          <div id="alert" style="margin-bottom:14px"></div>
          <!-- <label class="field"><span>Message to member</span><textarea rows="4" placeholder="Deposit confirmed after 12 network confirmations."></textarea></label> -->
          <div class="row"><button class="btn approve-btn" type="submit">Approve</button><button class="btn danger decline-btn" type="button">Decline</button></div>
        </form>
      </div>
    </div>
  </div>

  <div class="row between mt">
    <h2 class="section-title">Investments</h2><a href="/admin/investments?email=<%= userDetail.email %>" style="color:var(--primary);font-weight:700" class="small">View all</a>
  </div>
  <p class="muted small" style="margin:4px 0 0">Plans this member is running or has completed.</p>
  <div class="mt-sm">
    <div class="card table-card" data-paginate="10" id="tbl22" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Member</th>
              <th>Plan</th>
              <th>Amount</th>
              <th>Profit</th>
              <th>Status</th>
              <!-- <th>Action</th> -->
            </tr>
          </thead>
          <tbody>
            <% investments.forEach((investment, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= investment.user.firstName %> <%= investment.user.lastName %></td>
              <td><%= investment.plan.name %></td>
              <td><%= formatCurrency(investment.amount) %></td>
              <td><%= formatCurrency(investment.plan.roi) %>%</td>
              <td><span class="pill <%= investment.status === 'active' ? 'warning' : 'success' %>"><%= investment.status === 'active' ? 'Active' : 'Completed' %></span></td>
              <!-- <td><button class="btn sm ghost" onclick="openModal('inv-modal')">Adjust</button></td> -->
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% investments.forEach(investment => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= investment.user.firstName %> <%= investment.user.lastName %></strong><span class="pill <%= investment.status === 'active' ? 'warning' : 'success' %>"><%= investment.status === 'active' ? 'Active' : 'Completed' %></span></div>
          <div class="mini-row"><span><%= investment.plan.name %></span><span>$<%= formatCurrency(investment.amount) %></span></div>
          <div class="mini-row"><span>Profit</span><span><%= formatCurrency(investment.plan.roi) %>%</span></div>
          <!-- <button class="btn sm block" style="margin-top:10px" onclick="openModal('inv-modal')">Adjust</button> -->
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <h2 class="section-title mt">Referrals</h2>
  <div class="mt-sm">
    <div class="card table-card" data-paginate="10" id="tbl23" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Joined</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% referrals.forEach(referral => { %>
            <tr>
              <td><%= referral.firstName %> <%= referral.lastName %></td>
              <td><%= referral.email %></td>
              <% const date = referral.createdAt.toLocaleDateString() %>
              <% const time = referral.createdAt.toLocaleTimeString() %>
              <td><%= date %>, <%= time %></td>
              <td><span class="pill <%= referral.confirmed === true ? 'success' : 'pending' %>"><%= referral.confirmed === true ? 'Active' : 'Pending' %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% referrals.forEach(referral => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= referral.firstName %> <%= referral.lastName %></strong><span class="pill <%= referral.confirmed === true ? 'success' : 'pending' %>"><%= referral.confirmed === true ? 'Active' : 'Pending' %></span></div>
          <div class="mini-row"><span>Email</span><span><%= referral.email %></span></div>
          <% const date = referral.createdAt.toLocaleDateString() %>
          <% const time = referral.createdAt.toLocaleTimeString() %>
