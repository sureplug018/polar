            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo class="add-wallet-form">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>Name</span><input id="name" type="text" placeholder="USDT" /></label>
          <label class="field"><span>Wallet address</span><input id="address" type="text" placeholder="Paste the receiving address" /></label>
          <div class="row">
            <button class="btn add-wallet-btn" type="submit">Save wallet</button>
            <button class="btn danger" type="button" onclick="closeModal('add-wallet-modal')">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop" id="edit-wallet-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Wallet details</h3><button class="icon-btn" onclick="closeModal('edit-wallet-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo class="edit-wallet-form">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>Name</span><input id="edit-wallet-name" type="text" placeholder="USDT" /></label>
          <label class="field"><span>Address</span><input id="edit-wallet-address" type="text" placeholder="address" /></label>
          <label class="field"><span>Status</span>
            <select id="edit-wallet-status">
              <option value="">Select Status</option>
              <option value="active">Active</option>
              <option value="inactive">Disabled</option>
            </select>
          </label>
          <div class="row">
            <button class="btn edit-wallet-btn" type="submit">Save wallet</button>
            <button class="btn danger" type="button" onclick="closeModal('edit-wallet-modal')">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <h2 class="section-title mt">Email this member</h2>
  <div class="card mt-sm">
    <form data-demo class="send-support-form">
      <div id="alert" style="margin-bottom:14px"></div>
      <label class="field"><span>Subject</span><input type="text" id="support-subject" placeholder="Your withdrawal has been processed" /></label>
      <label class="field"><span>Message</span><textarea id="support-message" rows="4" placeholder="Write to the member…"></textarea></label>
      <button class="btn submit-message" type="submit">Send email</button>
    </form>
  </div>
</main>
<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
  const txModal = document.getElementById('tx-modal');
  const approveBtn = txModal.querySelector('.approve-btn');
  const declineBtn = txModal.querySelector('.decline-btn');
  const txButtons = document.querySelectorAll('button[data-transaction-id]');
  let currentTransactionId = null;

  // Reset buttons when modal is opened
  function resetButtons() {
    approveBtn.disabled = false;
    declineBtn.disabled = false;
    approveBtn.style.cursor = '';
    declineBtn.style.cursor = '';
    approveBtn.textContent = 'Approve';
    declineBtn.textContent = 'Decline';
  }

  txButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentTransactionId = button.getAttribute('data-transaction-id');
      resetButtons();
      openModal('tx-modal');
    });
  });

  function setProcessingState(clickedBtn) {
    approveBtn.disabled = true;
    declineBtn.disabled = true;
    approveBtn.style.cursor = 'not-allowed';
    declineBtn.style.cursor = 'not-allowed';
    clickedBtn.textContent = 'Processing...';
  }

  // Approve handler
  approveBtn.addEventListener('click', async () => {
    if (!currentTransactionId) {
      showAlert('error', 'Action not allowed', 'Transaction ID is missing.');
      return;
    }

    setProcessingState(approveBtn);

    try {
      const response = await axios.patch(`/api/v1/transactions/confirm-transaction/${currentTransactionId}`);
      if (response.data.status === 'success') {
        showAlert('success', 'Transaction approved successfully', 'The member has been notified by email.');
        setTimeout(() => {
          closeModal('tx-modal');
          location.reload();
        }, 2000);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      resetButtons();
    }
  });

  // Decline handler
  declineBtn.addEventListener('click', async () => {
    if (!currentTransactionId) {
      showAlert('error', 'Action not allowed', 'Transaction ID is missing.');
      return;
    }

    setProcessingState(declineBtn);

    try {
      const response = await axios.patch(`/api/v1/transactions/decline-transaction/${currentTransactionId}`);
      if (response.data.status === 'success') {
        showAlert('success', 'Transaction declined successfully', 'The member has been notified by email.');
        setTimeout(() => {
          closeModal('tx-modal');
          location.reload();
        }, 2000);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      resetButtons();
    }
  });
</script>

<script>
  // ========== Update Member Details Form ==========
  const userForm = document.querySelector('.user-form');
  const updateBtn = userForm.querySelector('.update-btn');

  userForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const userId = userForm.getAttribute('data-user-id');
    if (!userId) {
      showAlert('error', 'Action not allowed', 'User ID is missing.');
      return;
    }

    const firstName = userForm.querySelector('input[name="firstName"]').value.trim();
    const lastName = userForm.querySelector('input[name="lastName"]').value.trim();
    const email = userForm.querySelector('input[name="email"]').value.trim();
    const phoneNumber = userForm.querySelector('input[name="phoneNumber"]').value.trim();
    const status = userForm.querySelector('select[name="status"]').value;

    // Basic validation
    if (!firstName || !lastName || !email) {
      showAlert('error', 'Validation error', 'First name, last name and email are required.');
      return;
    }

    // Disable button & show processing
    updateBtn.disabled = true;
    updateBtn.style.cursor = 'not-allowed';
    const originalText = updateBtn.textContent;
    updateBtn.textContent = 'Processing...';

    try {
      const response = await axios.patch(`/api/v1/users/admin-edit-user-data/${userId}`, {
        firstName,
        lastName,
        email,
        phoneNumber,
        status
      });

      if (response.data.status === 'success') {
        showAlert('success', 'Member updated successfully', 'The changes are now live on the member dashboard.');
        setTimeout(() => {
          location.reload();
        }, 1500);
      }
    } catch (error) {
      console.error(error);
      showAlert('error', 'Error occurred.', error.response?.data?.message || 'An unexpected error occurred.');
      updateBtn.disabled = false;
      updateBtn.style.cursor = '';
      updateBtn.textContent = originalText;
    }
  });
</script>

