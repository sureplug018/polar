<%- include('partials/dashboardHeader') %>
<div class="content">
  <%- include('partials/dashboardHead') %>
  <main class="page">

    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">Withdraw funds</h1>
      <p class="muted" style="margin:6px 0 0">Request a payout to your external wallet.</p>
    </div>
    <div class="grid g4">
      <div class="card stat featured">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Available balance</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="6" width="18" height="13" rx="3" />
              <path d="M16 12.5h3" />
            </svg></span>
        </div>
        <p class="stat-value"><%= formatCurrency(user.balance) %></p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Pending payouts</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 3-6.7" />
              <path d="M3 4v5h5" />
              <path d="M12 8v4l3 2" />
            </svg></span>
        </div>
        <p class="stat-value"><%= formatCurrency(totalPendingWithdrawals) %></p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Total withdrawn</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21V9" />
              <path d="m7 12 5-5 5 5" />
              <path d="M4 3h16" />
            </svg></span>
        </div>
        <p class="stat-value"><%= formatCurrency(totalWithdrawn[0] ? totalWithdrawn[0].total : 0) %></p>
      </div>
    </div>
    <div class="grid g2-md mt">
      <div class="card">
        <h2 class="section-title">Payout request</h2>
        <form data-demo class="mt-sm">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>Payment Method</span>
            <select id="wallet-select">
              <option>Select an Wallet</option>
              <% wallets.forEach(wallet => { %>
              <option data-wallet-id="<%= wallet.id %>" data-wallet-name="<%= wallet.name %>" data-wallet-address="<%= wallet.address %>"><%= wallet.name %></option>
              <% }) %>
            </select>
          </label>
          <label class="field"><span>Amount (USD)</span>
            <input type="number" placeholder="1000" id="amount" />
          </label>
          <label class="field"><span>Destination wallet address</span>
            <input type="text" id="address" placeholder="Paste your wallet address" readonly />
          </label>
          <button class="btn block" type="submit">Request withdrawal</button>
          <!-- <div class="alert success mt" data-demo-note style="display:none">
            <h4>Withdrawal requested</h4>
            <p style="margin:0">Compliance review typically completes within 2 hours.</p>
          </div> -->
        </form>
      </div>
      <div class="card">
        <h2 class="section-title">Payout rules</h2>
        <ul class="muted" style="padding-left:18px;line-height:1.9">
          <li>Minimum withdrawal: $50</li>
          <li>Network fee is deducted from the requested amount</li>
          <li>Withdrawals process Monday–Saturday, 08:00–20:00 UTC</li>
          <li>Address must match your verified wallet</li>
        </ul>
        <div class="alert error">
          <h4>Declined payout</h4>
          <p style="margin:0">A recent withdrawal was declined because the destination wallet failed verification. <a href="/contact-us">Contact us</a></p>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  const walletSelect = document.querySelector('#wallet-select');
  const addressInput = document.querySelector('#address');

  walletSelect.addEventListener('change', function() {
    const selectedOption = this.options[this.selectedIndex];
    const walletAddress = selectedOption.getAttribute('data-wallet-address');
    addressInput.value = walletAddress || '';
  });

  document.querySelector('form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const walletId = walletSelect.options[walletSelect.selectedIndex].getAttribute('data-wallet-id');
    const walletName = walletSelect.options[walletSelect.selectedIndex].getAttribute('data-wallet-name');
    const amount = document.getElementById('amount').value;
    const address = document.getElementById('address').value;

    const button = document.querySelector('button[type="submit"]');
    button.disabled = true;
    button.textContent = 'Requesting...';
    button.style.cursor = 'not-allowed';

    try {
      const response = await axios.post('/api/v1/transactions/withdraw', {
        wallet: walletName,
        amount,
        address
      });

      if (response.data.status === 'success') {
        showAlert('success', 'Withdrawal Requested', 'Your withdrawal request has been submitted successfully.');
        // Optionally, you can clear the form fields after successful submission
        walletSelect.selectedIndex = 0;
        document.getElementById('amount').value = '';
        document.getElementById('address').value = '';
      }
    } catch (error) {
      console.error('Error requesting withdrawal:', error.response ? error.response.data : error.message);
      showAlert('error', 'Request Error', error.response && error.response.data && error.response.data.message ? error.response.data.message : 'An unexpected error occurred. Please try again.');
    } finally {
      button.disabled = false;
      button.textContent = 'Request withdrawal';
      button.style.cursor = 'pointer';
    }
  });
</script>
<%- include('partials/dashboardFooter') %>