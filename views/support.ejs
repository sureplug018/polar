<%- include('partials/dashboardHeader') %>
<div class="content">
  <%- include('partials/dashboardHead') %>
  <main class="page">

    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">Support</h1>
      <p class="muted" style="margin:6px 0 0">We usually reply within an hour. Email support@tescomint.com.</p>
    </div>
    <div class="grid g2-md">
      <div class="card">
        <h2 class="section-title">Open a ticket</h2>
        <form data-demo class="mt-sm">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>Subject</span><input id="subject" type="text" placeholder="Deposit not reflecting" /></label>
          <label class="field"><span>Category</span><select id="category">
              <option>Deposits</option>
              <option>Withdrawals</option>
              <option>Investments</option>
              <option>Account</option>
              <option>Other</option>
            </select></label>
          <label class="field"><span>Message</span><textarea id="message" rows="4" placeholder="Describe the issue with as much detail as possible."></textarea></label>
          <button class="btn block" type="submit">Send message</button>
        </form>
      </div>
      <div class="card">
        <h2 class="section-title">Your tickets</h2>
        <div class="cards-list" style="display:grid;margin-top:10px">
          <% supports.forEach(support => { %>
          <div class="mini-card">
            <div class="row between"><strong><%= support.subject %></strong><span class="pill <%= support.status === 'replied' ? 'success' : 'warning' %>"><%= support.status === 'replied' ? 'Closed' : 'Open' %></span></div>
            <p class="muted small" style="margin:8px 0 0"><%= support.message %></p>
            <p class="muted small" style="margin:6px 0 0"><%= support.createdAt.toLocaleDateString() %></p>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
  document.querySelector('form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const subject = document.getElementById('subject').value;
    const category = document.getElementById('category').value;
    const message = document.getElementById('message').value;

    const button = document.querySelector('button[type="submit"]');
    button.disabled = true;
    button.textContent = 'Sending...';
    button.style.cursor = 'not-allowed';

    try {
      const response = await axios.post('/api/v1/supports/send-support', {
        subject,
        category,
        message
      });

      if (response.data.status === 'success') {
        showAlert('success', 'Ticket Submitted', 'Your support ticket has been submitted successfully.');
        // Optionally, you can clear the form fields after successful submission
        document.getElementById('subject').value = '';
        document.getElementById('category').selectedIndex = 0;
        document.getElementById('message').value = '';
      }
    } catch (error) {
      console.error('Error submitting support ticket:', error.response ? error.response.data : error.message);
      showAlert('error', 'Submission Error', error.response && error.response.data && error.response.data.message ? error.response.data.message : 'An unexpected error occurred. Please try again.');
    } finally {
      button.disabled = false;
      button.textContent = 'Send message';
      button.style.cursor = 'pointer';
    }
  });
</script>

<%- include('partials/dashboardFooter') %>