<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Members</h1>
    <p class="muted" style="margin:6px 0 0">Open a member to manage everything about their account.</p>
  </div>
  <div class="card">
    <div class="grid g3"><label class="field"><span>Search</span><input type="text" placeholder="Name or email" /></label><label class="field"><span>Status</span><select>
          <option>All</option>
          <option>Active</option>
          <option>Pending</option>
          <option>Suspended</option>
        </select></label><label class="field"><span>Verification</span><select>
          <option>All</option>
          <option>Verified</option>
          <option>Unverified</option>
        </select></label></div>
  </div>
  <div class="mt">
    <div class="card table-card" data-paginate="10" id="tbl8" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Balance</th>
              <th>Profit</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= user.firstName %> <%= user.lastName %></td>
              <td><%= user.email %></td>
              <td>$<%= formatCurrency(user.balance) %></td>
              <td>$<%= formatCurrency(user.profit) %></td>
              <td><span class="pill <%= user.confirmed === true ? 'success' : 'warning' %>"><%= user.confirmed === true ? 'Verified' : 'Unverified' %></span></td>
              <td><a class="btn sm ghost" href="/admin/users/<%= user.id %>">Open profile</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% users.forEach(user => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= user.firstName %> <%= user.lastName %></strong><span class="pill <%= user.confirmed === true ? 'success' : 'warning' %>"><%= user.confirmed === true ? 'Verified' : 'Unverified' %></span></div>
          <div class="mini-row"><span>Email</span><span><%= user.email %></span></div>
          <div class="mini-row"><span>Balance</span><span>$<%= formatCurrency(user.balance) %></span></div>
          <div class="mini-row"><span>Profit</span><span>$<%= formatCurrency(user.profit) %></span></div>
          <div class="mini-row"><span>Country</span><span><%= user.country %></span></div>
          <a class="btn sm block" style="margin-top:10px" href="/admin/users/<%= user.id %>">Open profile</a>
        </div>
        <% }) %>
      </div>
      <div class="pager" data-pager hidden>
        <button class="btn sm ghost" type="button" data-page-prev>Previous</button>
        <span class="muted small" data-page-info></span>
        <button class="btn sm ghost" type="button" data-page-next>Next</button>
      </div>
    </div>
  </div>
</main>
<%- include('partials/adminFooter') %>