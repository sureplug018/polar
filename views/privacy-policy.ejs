  <section class="page-hero" style="text-align: center;">
    <div class="container reveal">
      <span class="eyebrow">Legal</span>
      <h1>Privacy <span class="gradient-text">Policy</span></h1>
      <p>Last updated: January 1, 2026</p>
    </div>
