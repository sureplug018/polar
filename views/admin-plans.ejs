<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Investment plans</h1>
    <p class="muted" style="margin:6px 0 0">Create and tune the plans available to members.</p>
  </div>
  <div class="row between">
    <h2 class="section-title">Plans</h2><button class="btn sm" onclick="openModal('plan-modal')">Add plan</button>
  </div>
  <div class="grid g4 mt-sm">
    <% plans.forEach(plan => { %>
    <div class="card">
      <div class="row between"><strong><%= plan.name %></strong></div>
      <p class="stat-value" style="color:var(--primary)"><%= plan.roi %></p>
      <div class="mini-row"><span>Duration</span><span><%= plan.duration %> Days</span></div>
      <div class="mini-row"><span>Range</span><span>$<%= plan.min %> - $<%= plan.max %></span></div>
      <button class="btn sm block" style="margin-top:12px" onclick="openModal('plan-modal')">Edit plan</button>
    </div>
    <% }) %>
  </div>
  <div class="modal-backdrop" id="plan-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Plan details</h3><button class="icon-btn" onclick="closeModal('plan-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo>
          <div class="grid g2-md"><label class="field"><span>Name</span><input type="text" placeholder="Growth" /></label><label class="field"><span>ROI</span><input type="text" placeholder="25% ROI" /></label></div>
          <div class="grid g2-md"><label class="field"><span>Minimum (USD)</span><input type="number" placeholder="2000" /></label><label class="field"><span>Maximum (USD)</span><input type="number" placeholder="10000" /></label></div>
          <div class="grid g2-md"><label class="field"><span>Duration</span><input type="text" placeholder="30 days" /></label><label class="field"><span>Referral</span><input type="text" placeholder="5% referral" /></label></div>
          <div class="row"><button class="btn" type="submit">Save plan</button><button class="btn danger" type="button" onclick="closeModal('plan-modal')">Delete</button></div>
          <div class="alert success mt" data-demo-note style="display:none">
            <h4>Plan saved</h4>
            <p style="margin:0">The plan is now live for members.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>
<%- include('partials/adminFooter') %>