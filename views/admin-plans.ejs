      </div>
      <div class="row between"><h2 class="section-title">Plans</h2><button class="btn sm" onclick="openModal('plan-modal')">Add plan</button></div>
<div class="grid g4 mt-sm"><div class="card"><div class="row between"><strong>Starter</strong></div>
  <p class="stat-value" style="color:var(--primary)">14% ROI</p>
  <div class="mini-row"><span>Duration</span><span>14 days</span></div>
  <div class="mini-row"><span>Range</span><span>$100.00 – $2,000.00</span></div>
  <div class="mini-row"><span>Referral</span><span>3% referral</span></div>
  <button class="btn sm block" style="margin-top:12px" onclick="openModal('plan-modal')">Edit plan</button></div><div class="card"><div class="row between"><strong>Growth</strong><span class="pill success">success</span></div>
  <p class="stat-value" style="color:var(--primary)">25% ROI</p>
  <div class="mini-row"><span>Duration</span><span>30 days</span></div>
  <div class="mini-row"><span>Range</span><span>$2,000.00 – $10,000.00</span></div>
  <div class="mini-row"><span>Referral</span><span>5% referral</span></div>
  <button class="btn sm block" style="margin-top:12px" onclick="openModal('plan-modal')">Edit plan</button></div><div class="card"><div class="row between"><strong>Premium</strong></div>
  <p class="stat-value" style="color:var(--primary)">36% ROI</p>
  <div class="mini-row"><span>Duration</span><span>60 days</span></div>
  <div class="mini-row"><span>Range</span><span>$10,000.00 – $50,000.00</span></div>
  <div class="mini-row"><span>Referral</span><span>7% referral</span></div>
  <button class="btn sm block" style="margin-top:12px" onclick="openModal('plan-modal')">Edit plan</button></div><div class="card"><div class="row between"><strong>Institutional</strong></div>
  <p class="stat-value" style="color:var(--primary)">52% ROI</p>
  <div class="mini-row"><span>Duration</span><span>90 days</span></div>
  <div class="mini-row"><span>Range</span><span>$50,000.00 – $250,000.00</span></div>
  <div class="mini-row"><span>Referral</span><span>10% referral</span></div>
  <button class="btn sm block" style="margin-top:12px" onclick="openModal('plan-modal')">Edit plan</button></div></div>
<div class="modal-backdrop" id="plan-modal">
  <div class="modal">
    <div class="row between"><h3 style="font-size:18px">Plan details</h3><button class="icon-btn" onclick="closeModal('plan-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12"/><path d="m18 6-12 12"/></svg></button></div>
    <div class="mt"><form data-demo><div class="grid g2-md"><label class="field"><span>Name</span><input type="text" placeholder="Growth" /></label><label class="field"><span>ROI</span><input type="text" placeholder="25% ROI" /></label></div><div class="grid g2-md"><label class="field"><span>Minimum (USD)</span><input type="number" placeholder="2000" /></label><label class="field"><span>Maximum (USD)</span><input type="number" placeholder="10000" /></label></div><div class="grid g2-md"><label class="field"><span>Duration</span><input type="text" placeholder="30 days" /></label><label class="field"><span>Referral</span><input type="text" placeholder="5% referral" /></label></div><div class="row"><button class="btn" type="submit">Save plan</button><button class="btn danger" type="button" onclick="closeModal('plan-modal')">Delete</button></div><div class="alert success mt" data-demo-note style="display:none"><h4>Plan saved</h4><p style="margin:0">The plan is now live for members.</p></div></form></div>
