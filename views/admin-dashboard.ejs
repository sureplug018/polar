<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Operations overview</h1>
    <p class="muted" style="margin:6px 0 0">Platform-wide activity across members, capital and payouts.</p>
  </div>
  <div class="grid g4">
    <div class="card stat featured">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Total members</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20" />
            <circle cx="8.5" cy="8" r="3.2" />
            <path d="M17 4.3a4 4 0 0 1 0 7.4" />
            <path d="M21 20v-1.5a4 4 0 0 0-3-3.8" />
          </svg></span>
      </div>
      <p class="stat-value"><%= users.length.toLocaleString() %></p>
      <p class="muted small" style="margin:6px 0 0"><%= pendingVerifications.length.toLocaleString() %> pending verification</p>
    </div>
    <div class="card stat">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Total Deposits</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="6" width="18" height="13" rx="3" />
            <path d="M16 12.5h3" />
          </svg></span>
      </div>
      <% let totalDeposits = 0 %>
      <% deposits.forEach(deposit => { %>
      <% totalDeposits += deposit.amount %>
      <% }) %>
      <p class="stat-value">$<%= formatCurrency(totalDeposits) %></p>
    </div>
    <div class="card stat">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Pending payouts</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21V9" />
            <path d="m7 12 5-5 5 5" />
            <path d="M4 3h16" />
          </svg></span>
      </div>
      <% let totalWithdrawal = 0 %>
      <% withdrawals.forEach(withdrawal => { %>
      <% totalWithdrawal += withdrawal.amount %>
      <% }) %>
      <p class="stat-value">$<%= formatCurrency(totalWithdrawal) %></p>
      <p class="muted small" style="margin:6px 0 0"><%= withdrawals.filter(w => w.status === 'pending').length %> awaiting review</p>
    </div>
    <div class="card stat">
      <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
        <p class="eyebrow">Open tickets</p>
        <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
            <rect x="2.5" y="13" width="4" height="6" rx="2" />
            <rect x="17.5" y="13" width="4" height="6" rx="2" />
            <path d="M20 19v.5a3 3 0 0 1-3 3h-3" />
          </svg></span>
      </div>
      <p class="stat-value"><%= supports.length %></p>
    </div>
  </div>
  <div class="card mt">
    <div class="row between">
      <h2 class="section-title">Deposit volume</h2><span class="muted small">Last 6 months</span>
    </div>
    <svg class="chart" data-values='[5000,8000,12000,9000,16000,12000]' data-labels='["Mar","Apr","May","Jun","Jul","Aug"]'></svg>
  </div>
  <div class="row between mt">
    <h2 class="section-title">Recent transactions</h2><a href="/admin/transactions" style="color:var(--primary);font-weight:700" class="small">View all</a>
  </div>
  <div class="mt-sm">
    <div class="card table-card" data-paginate="10" id="tbl5" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Member</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Wallet</th>
              <th>Address</th>
              <th>Status</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.slice(0, 10).forEach((transaction, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= transaction.user.firstName %> <%= transaction.user.lastName %></td>
              <td><%= transaction.type %></td>
              <td>$<%= formatCurrency(transaction.amount) %></td>
              <td><%= transaction.wallet %></td>
              <td><%= transaction.address || 'N/A' %></td>
              <td><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></td>
              <% const date = transaction.createdAt.toLocaleDateString() %>
              <% const time = transaction.createdAt.toLocaleTimeString() %>
              <td><%= date %>, <%= time %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% transactions.forEach((transaction, i) => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= transaction.user.firstName %> <%= transaction.user.lastName %></strong><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></div>
          <div class="mini-row"><span><%= transaction.type %></span><span>$<%= formatCurrency(transaction.amount) %></span></div>
          <% const date = transaction.createdAt.toLocaleDateString() %>
          <% const time = transaction.createdAt.toLocaleTimeString() %>
          <div class="mini-row"><span>Date</span><span><%= date %>, <%= time %></span></div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</main>
<%- include('partials/adminFooter') %>