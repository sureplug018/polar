<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Deposit wallets</h1>
    <p class="muted" style="margin:6px 0 0">Add, edit or disable the wallets shown to members.</p>
  </div>
  <div class="row between">
    <h2 class="section-title">Wallets</h2><button class="btn sm" onclick="openModal('wallet-modal')">Add wallet</button>
  </div>
  <div class="mt-sm">
    <div class="card table-card" data-paginate="10" id="tbl24" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>S/No</th>
              <th>Wallet</th>
              <th>Address</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% wallets.forEach((wallet, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= wallet.name %></td>
              <td><%= wallet.address %></td>
              <td><span class="pill <%= wallet.status === 'active' ? 'success' : 'error' %>"><%= wallet.status === 'active' ? 'Active' : 'Inactive' %></span></td>
              <td><button class="btn sm ghost" onclick="openModal('wallet-modal')">Edit</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% wallets.forEach((wallet) => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= wallet.name %></strong><span class="pill <%= wallet.status === 'active' ? 'success' : 'error' %>"><%= wallet.status === 'active' ? 'Active' : 'Inactive' %></span></div>
          <p class="muted small" style="word-break:break-all;margin:8px 0 0"><%= wallet.address %></p>
          <button class="btn sm block" style="margin-top:10px" onclick="openModal('wallet-modal')">Edit</button>
        </div>
        <% }) %>
      </div>
      <div class="pager" data-pager hidden>
        <button class="btn sm ghost" type="button" data-page-prev>Previous</button>
        <span class="muted small" data-page-info></span>
        <button class="btn sm ghost" type="button" data-page-next>Next</button>
      </div>
    </div>
  </div>
  <div class="modal-backdrop" id="wallet-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Wallet details</h3><button class="icon-btn" onclick="closeModal('wallet-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo><label class="field"><span>Asset</span><input type="text" placeholder="Tether" /></label><label class="field"><span>Network</span><input type="text" placeholder="TRC20" /></label><label class="field"><span>Wallet address</span><input type="text" placeholder="Paste the receiving address" /></label><label class="field"><span>Status</span><select>
              <option>Active</option>
              <option>Disabled</option>
            </select></label>
          <div class="row"><button class="btn" type="submit">Save wallet</button><button class="btn danger" type="button" onclick="closeModal('wallet-modal')">Delete</button></div>
          <div class="alert success mt" data-demo-note style="display:none">
            <h4>Wallet saved</h4>
            <p style="margin:0">Members will see this wallet on the deposit page.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>
<%- include('partials/adminFooter') %>