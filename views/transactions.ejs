<%- include('partials/dashboardHeader') %>
<div class="content">
  <%- include('partials/dashboardHead') %>
  <main class="page">

    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">Transactions</h1>
      <p class="muted" style="margin:6px 0 0">Every deposit, withdrawal, profit and bonus on your account.</p>
    </div>
    <!-- <div class="card">
      <div class="grid g3">
        <label class="field"><span>Search</span><input type="text" placeholder="Search by ID or type" /></label>
        <label class="field"><span>Type</span><select>
            <option>All types</option>
            <option>Deposit</option>
            <option>Withdrawal</option>
            <option>Investment</option>
            <option>Profit</option>
            <option>Referral Bonus</option>
          </select></label>
        <label class="field"><span>Status</span><select>
            <option>All statuses</option>
            <option>Success</option>
            <option>Pending</option>
            <option>Warning</option>
            <option>Error</option>
          </select></label>
      </div>
    </div> -->
    <div class="mt">
      <div class="card table-card" data-paginate="10" id="tbl2" style="padding:6px">
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Gateway</th>
                <th>Address</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach((transaction, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= transaction.type %></td>
                <td>$<%= formatCurrency(transaction.amount) %></td>
                <td><%= transaction.wallet %></td>
                <td><%= transaction.address || 'N/A' %></td>
                <td><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></td>
                <% const date = transaction.createdAt.toLocaleDateString() %>
                <% const time = transaction.createdAt.toLocaleTimeString() %>
                <td><%= date %>, <%= time %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="cards-list" style="padding:10px">
          <% transactions.slice(0, 5).forEach(transaction => { %>
          <div class="mini-card">
            <div class="row between"><strong><%= transaction.type %></strong><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></div>
            <div class="mini-row"><span>Amount</span><span>$<%= formatCurrency(transaction.amount) %></span></div>
            <div class="mini-row"><span>Asset</span><span><%= transaction.wallet %></span></div>
            <div class="mini-row"><span>Date</span><span><%= transaction.createdAt.toLocaleDateString() %>, <%= transaction.createdAt.toLocaleTimeString() %></span></div>
            <!-- <p class="muted small" style="margin:8px 0 0">Deposit confirmed after 12 network confirmations.</p> -->
          </div>
          <% }) %>
        </div>
        <div class="pager" data-pager hidden>
          <button class="btn sm ghost" type="button" data-page-prev>Previous</button>
          <span class="muted small" data-page-info></span>
          <button class="btn sm ghost" type="button" data-page-next>Next</button>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/dashboardFooter') %>