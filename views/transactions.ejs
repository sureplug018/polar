      <div class="grid g3">
        <label class="field"><span>Search</span><input type="text" placeholder="Search by ID or type" /></label>
        <label class="field"><span>Type</span><select>
            <option>All types</option>
            <option>Deposit</option>
            <option>Withdrawal</option>
            <option>Investment</option>
            <option>Profit</option>
            <option>Referral Bonus</option>
