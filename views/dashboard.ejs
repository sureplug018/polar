<%- include('partials/dashboardHeader') %>
<div class="content">
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <button class="icon-btn hide-desktop" type="button" aria-label="Open menu" onclick="openNav()"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg></button>
        <a class="brand" href="/">
          <img src="/assets/home/images/logo.png" style="width: 120px; height: auto;" alt="">
        </a>
      </div>
      <div class="row">
        <button class="icon-btn" aria-label="Notifications"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 9a6 6 0 1 0-12 0c0 5-2 6-2 6h16s-2-1-2-6" />
            <path d="M10.5 20a2 2 0 0 0 3 0" />
          </svg>
        </button>
        <button class="icon-btn" type="button" aria-label="Toggle dark mode" onclick="toggleTheme()"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />
          </svg>
        </button>
      </div>
    </div>
  </header>
  <main class="page">
    <% if(message){ %>
    <div class="alert <%= message.status %>" style="margin-bottom: 15px;">
      <div style="display: flex; justify-content: space-between;">
        <h4><%= message.title %></h4>
        <span style="font-size: larger; color: #666; font-weight: bold;">x</span>
      </div>

      <p style="margin:0"><%= message.message %> <a href="/contact-us">Contact us</a></p>
    </div>
    <% } %>
    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">Dashboard</h1>
      <p class="muted" style="margin:6px 0 0">Your portfolio at a glance.</p>
    </div>
    <div class="grid g4">
      <div class="card stat featured">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Account balance</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="6" width="18" height="13" rx="3" />
              <path d="M16 12.5h3" />
            </svg></span>
        </div>
        <p class="stat-value">$<%= formatCurrency(user.balance) %></p>
        <p class="muted small" style="margin:6px 0 0">Available to withdraw</p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Profit Balance</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12a7 7 0 0 1 7-7h3a7 7 0 0 1 7 7v3a3 3 0 0 1-3 3h-1l-1 2h-3l-1-2H7a3 3 0 0 1-3-3Z" />
              <circle cx="9" cy="12" r="1" />
            </svg></span>
        </div>
        <p class="stat-value">$<%= formatCurrency(user.profit) %></p>
        <p class="muted small" style="margin:6px 0 0">Available Profit</p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Total Deposits</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 16 5-5 4 4 8-8" />
              <path d="M20 7v5h-5" />
            </svg></span>
        </div>
        <% let totalDeposits = 0 %>
        <% deposits.forEach(deposit => { %>
        <% totalDeposits += deposit.amount %>
        <% }) %>
        <p class="stat-value">$<%= formatCurrency(totalDeposits) %></p>
        <p class="muted small" style="margin:6px 0 0">All deposits</p>
      </div>
      <div class="card stat">
        <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
          <p class="eyebrow">Total Investments</p>
          <span class="stat-icon"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" />
              <circle cx="9.5" cy="8" r="3.2" />
              <path d="M18 8.5h4" />
              <path d="M20 6.5v4" />
            </svg></span>
        </div>
        <% let totalInvestments = 0 %>
        <% investments.forEach(investment => { %>
        <% totalInvestments += investment.amount %>
        <% }) %>
        <p class="stat-value">$<%= formatCurrency(totalInvestments) %></p>
        <p class="muted small" style="margin:6px 0 0">All investments</p>
      </div>
    </div>
    <h2 class="section-title mt">Quick actions</h2>
    <div class="quick-grid mt-sm"><a class="quick-action" href="/deposit"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" />
            <path d="m7 12 5 5 5-5" />
            <path d="M4 21h16" />
          </svg></span><span>Deposit</span></a><a class="quick-action" href="/withdraw"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21V9" />
            <path d="m7 12 5-5 5 5" />
            <path d="M4 3h16" />
          </svg></span><span>Withdraw</span></a><a class="quick-action" href="/deposit"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 3v18h18" />
            <path d="m7 14 4-4 3 3 5-6" />
          </svg></span><span>Invest</span></a><a class="quick-action" href="/transactions"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 3-6.7" />
            <path d="M3 4v5h5" />
            <path d="M12 8v4l3 2" />
          </svg></span><span>Transactions</span></a><a class="quick-action" href="/investments"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="6" width="18" height="13" rx="3" />
            <path d="M3 10h18" />
            <circle cx="17" cy="14" r="1.4" />
          </svg></span><span>Investments</span></a><a class="quick-action" href="/referrals"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" />
            <circle cx="9.5" cy="8" r="3.2" />
            <path d="M18 8.5h4" />
            <path d="M20 6.5v4" />
          </svg></span><span>Referrals</span></a><a class="quick-action" href="/profile"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="3.6" />
            <path d="M4.5 20a7.5 7.5 0 0 1 15 0" />
          </svg></span><span>Profile</span></a><a class="quick-action" href="/support"><span class="quick-ico"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
            <rect x="2.5" y="13" width="4" height="6" rx="2" />
            <rect x="17.5" y="13" width="4" height="6" rx="2" />
            <path d="M20 19v.5a3 3 0 0 1-3 3h-3" />
          </svg></span><span>Support</span></a></div>
    <div class="card mt">
      <div class="row between">
        <h2 class="section-title">Profit performance</h2><span class="muted small">Last 6 months</span>
      </div>
      <svg class="chart" data-values='[420,860,1240,980,1710,2140]' data-labels='["Mar","Apr","May","Jun","Jul","Aug"]'></svg>
    </div>
    <div class="row between mt">
      <h2 class="section-title">Recent transactions</h2><a href="/transactions" style="color:var(--primary);font-weight:700" class="small">View all</a>
    </div>
    <div class="mt-sm">
      <div class="card table-card" data-paginate="10" id="tbl1" style="padding:6px">
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Gateway</th>
                <th>Address</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach((transaction, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= transaction.type %></td>
                <td>$<%= formatCurrency(transaction.amount) %></td>
                <td><%= transaction.wallet %></td>
                <td><%= transaction.address || 'N/A' %></td>
                <td><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></td>
                <% const date = transaction.createdAt.toLocaleDateString() %>
                <% const time = transaction.createdAt.toLocaleTimeString() %>
                <td><%= date %>, <%= time %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="cards-list" style="padding:10px">
          <% transactions.slice(0, 5).forEach(transaction => { %>
          <div class="mini-card">
            <div class="row between"><strong><%= transaction.type %></strong><span class="pill <%= transaction.status === 'declined' ? 'error' : transaction.status === 'pending' ? 'warning' : 'success' %>"><%= transaction.status %></span></div>
            <div class="mini-row"><span>Amount</span><span>$<%= formatCurrency(transaction.amount) %></span></div>
            <div class="mini-row"><span>Asset</span><span><%= transaction.wallet %></span></div>
            <div class="mini-row"><span>Date</span><span><%= transaction.createdAt.toLocaleDateString() %>, <%= transaction.createdAt.toLocaleTimeString() %></span></div>
            <!-- <p class="muted small" style="margin:8px 0 0">Deposit confirmed after 12 network confirmations.</p> -->
          </div>
          <% }) %>
        </div>
        <!-- <div class="pager" data-pager hidden>
          <button class="btn sm ghost" type="button" data-page-prev>Previous</button>
          <span class="muted small" data-page-info></span>
          <button class="btn sm ghost" type="button" data-page-next>Next</button>
        </div> -->
      </div>
    </div>
  </main>
</div>
<%- include('partials/dashboardFooter') %>