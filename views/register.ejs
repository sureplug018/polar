<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Create account — Polaris Financial Cooperation</title>
  <meta name="description" content="Open a Polaris Financial Cooperation investor account and start funding investment plans in minutes." />
  <meta property="og:title" content="Create account — Polaris Financial Cooperation" />
  <meta property="og:description" content="Open a Polaris Financial Cooperation investor account and start funding investment plans in minutes." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="/assets/css/app.css" />
  <script src="/assets/js/app.js" defer></script>
</head>

<body>
  <header class="topbar-inner" style="max-width:1040px">
    <a class="brand" href="/">
      <img src="/assets/home/images/logo.png" style="width: 120px; height: auto;" alt="">
    </a>
    <button class="icon-btn" type="button" aria-label="Toggle dark mode" onclick="toggleTheme()"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="8" />
        <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />
      </svg></button>
  </header>
  <main class="auth-wrap">
    <section class="hide-mobile">
      <p class="eyebrow accent">Secure investor access</p>
      <h2 style="font-size:34px;margin-top:12px">Digital asset investing, done seriously.</h2>
      <p class="muted" style="max-width:420px">Track deposits, run investment plans, monitor profits and manage payouts from one clean dashboard.</p>
    </section>
    <section class="auth-card">
      <h1 style="font-size:24px">Create your account</h1>
      <p class="muted">It takes under two minutes to get started.</p>
      <div class="mt">
        <form class="register-form">
          <div id="alert" style="margin-bottom:14px"></div>
          <div class="grid g2-md">
            <label class="field"><span>First name</span><input id="first-name" type="text" placeholder="John" /></label>
            <label class="field"><span>Last name</span><input id="last-name" type="text" placeholder="Doe" /></label>
          </div>
          <label class="field"><span>Username</span><input id="username" type="text" placeholder="john_doe" /></label>
          <label class="field"><span>Email address</span><input id="email" type="email" placeholder="you@example.com" /></label>
          <label class="field"><span>Country</span><input id="country" type="text" placeholder="Country" /></label>
          <label class="field"><span>Phone</span><input id="phone" type="text" placeholder="+0 0000 000 0000" /></label>
          <div class="grid g2-md"><label class="field"><span>Password</span><input id="password" type="password" placeholder="••••••••" /></label><label class="field"><span>Confirm password</span><input id="confirm-password" type="password" placeholder="••••••••" /></label></div>
          <label class="field">
            <span>Referral code (optional)</span>
            <input id="refcode" type="text" placeholder="Referral code" value="<%= typeof refcode !== 'undefined' && refcode ? refcode : '' %>" <%= typeof refcode !== 'undefined' && refcode ? 'disabled' : '' %> />
          </label> <label class="row small" style="gap:6px;margin-bottom:14px"><input type="checkbox" /> I agree to the terms of service and privacy policy.</label>
          <button class="btn block submit-btn" type="submit">Create account</button>
        </form>
      </div>
      <p class="muted mt">Already registered? <a href="/sign-in" style="color:var(--primary);font-weight:700">Sign in</a></p>
    </section>
  </main>
</body>
<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
  document.querySelector('.register-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const firstName = document.getElementById('first-name').value;
    const lastName = document.getElementById('last-name').value;
    const username = document.getElementById('username').value;
    const email = document.getElementById('email').value;
    const country = document.getElementById('country').value;
    const phone = document.getElementById('phone').value;
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirm-password').value;
    const refcode = document.getElementById('refcode').value;
    const button = document.querySelector('.submit-btn');
    button.disabled = true;
    button.textContent = 'Creating account...';
    button.style.cursor = 'not-allowed';

    if (password !== confirmPassword) {
      showAlert('error', 'Password Mismatch', 'Passwords do not match. Please try again.');
      button.disabled = false;
      button.textContent = 'Create account';
      button.style.cursor = 'pointer';
      return;
    }

    try {
      const response = await axios.post('/api/v1/users/signup', {
        firstName,
        lastName,
        username,
        email,
        country,
        phoneNumber: phone,
        password,
        passwordConfirm: confirmPassword,
        referral: refcode
      });

      if (response.data.status === 'success') {
        showAlert('success', 'Registration Successful', 'Your account has been created. Redirecting to dashboard...');
        setTimeout(() => {
          button.disabled = false;
          button.textContent = 'Create account';
          button.style.cursor = 'pointer';
          window.location.href = '/sign-in';
        }, 1500);
      } else {
        button.disabled = false;
        button.textContent = 'Create account';
        button.style.cursor = 'pointer';
        console.error('Registration failed:', response.data);
        showAlert('error', 'Registration Error', response.data.message);
      }
    } catch (error) {
      button.disabled = false;
      button.textContent = 'Create account';
      console.error('Error during registration:', error.response ? error.response.data : error.message);
      showAlert('error', 'Registration Error', error.response && error.response.data && error.response.data.message ? error.response.data.message : 'An unexpected error occurred. Please try again.');
    }
  });
</script>

</html>