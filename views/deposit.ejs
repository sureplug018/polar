<%- include('partials/dashboardHeader') %>
<div class="content">
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <button class="icon-btn hide-desktop" type="button" aria-label="Open menu" onclick="openNav()"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg></button>
        <span class="brand-mark hide-desktop">T</span>
        <div style="min-width:0">
          <p class="eyebrow">Welcome back</p>
          <p style="margin:0;font-size:14px;font-weight:700">Adaeze Okonkwo</p>
        </div>
      </div>
      <div class="row"><button class="icon-btn" aria-label="Notifications"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 9a6 6 0 1 0-12 0c0 5-2 6-2 6h16s-2-1-2-6" />
            <path d="M10.5 20a2 2 0 0 0 3 0" />
          </svg></button><button class="icon-btn" type="button" aria-label="Toggle dark mode" onclick="toggleTheme()"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />
          </svg></button></div>
    </div>
  </header>
  <main class="page">

    <div style="margin-bottom:18px">
      <h1 style="font-size:24px">Deposit funds</h1>
      <p class="muted" style="margin:6px 0 0">Send crypto to a Tescomint wallet and confirm your payment.</p>
    </div>
    <div class="alert warning">
      <h4>Send only the selected asset</h4>
      <p style="margin:0">Sending a different coin or network will result in permanent loss of funds. <a href="../user/support.html">Contact us</a></p>
    </div>
    <div class="grid g2-md mt">
      <div class="card">
        <h2 class="section-title">Payment details</h2>
        <form data-demo class="mt-sm">
          <label class="field"><span>Select wallet</span><select>
              <option>Bitcoin (BTC)</option>
              <option>Tether (TRC20)</option>
              <option>Ethereum (ERC20)</option>
            </select></label>
          <label class="field"><span>Amount (USD)</span><input type="number" placeholder="500" /></label>
          <button class="btn block" type="submit">I have made this payment</button>
          <div class="alert success mt" data-demo-note style="display:none">
            <h4>Payment submitted</h4>
            <p style="margin:0">Your deposit is pending confirmation. It usually clears within 30 minutes.</p>
          </div>
        </form>
      </div>
      <div class="card" style="text-align:center">
        <p class="eyebrow">Scan to pay</p>
        <img class="qr mt-sm" alt="Deposit wallet QR code" src="https://api.qrserver.com/v1/create-qr-code/?size=320x320&margin=8&data=TQ9xLm4Vd7Kp2Rn8Ws3Yb6Zc1Fh5Jg0Ae" />
        <div class="copy-box mt"><span id="addr">TQ9xLm4Vd7Kp2Rn8Ws3Yb6Zc1Fh5Jg0Ae</span><button class="btn sm ghost" onclick="copyText(document.getElementById('addr').textContent, this)">Copy</button></div>
        <p class="muted small mt-sm">Tether · TRC20 network</p>
      </div>
    </div>
    <h2 class="section-title mt">All deposit wallets</h2>
    <div class="grid g2-md mt-sm">
      <div class="card">
        <div class="row between"><strong>Bitcoin · BTC</strong><span class="pill success">success</span></div>
        <div class="copy-box mt-sm"><span>bc1qx8k4y2vn6r7t3m9plq0wz5s8d4hg7fjc2ne1ka</span></div>
      </div>
      <div class="card">
        <div class="row between"><strong>Tether · TRC20</strong><span class="pill success">success</span></div>
        <div class="copy-box mt-sm"><span>TQ9xLm4Vd7Kp2Rn8Ws3Yb6Zc1Fh5Jg0Ae</span></div>
      </div>
      <div class="card">
        <div class="row between"><strong>Ethereum · ERC20</strong><span class="pill success">success</span></div>
        <div class="copy-box mt-sm"><span>0x7Fa3B21c9De04Ec8815bA6f4703cD19eF52aB6d1</span></div>
      </div>
      <div class="card">
        <div class="row between"><strong>Solana · SOL</strong><span class="pill error">error</span></div>
        <div class="copy-box mt-sm"><span>5Hb9KpQr3Tz8Vm2Wn7Yc4Xd6Fe1Gh0Jk3Lm5Np8Qr2S</span></div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/dashboardFooter') %>