<%- include('partials/adminHeader') %>
<main class="page">

  <div style="margin-bottom:18px">
    <h1 style="font-size:24px">Investments</h1>
    <p class="muted" style="margin:6px 0 0">Adjust profit and manage the lifecycle of member plans.</p>
  </div>
  <div class="card">
    <form method="GET">
      <div class="grid g3"><label class="field"><span>Search</span><input type="text" name="email" placeholder="Search by email..." value="<%= query.email || '' %>" /></label>
    </form>
    <!-- <label class="field"><span>Type</span>
        <select>
          <option>All types</option>
          <option>Deposit</option>
          <option>Withdrawal</option>
          <option>Profit</option>
        </select>
      </label>
      <label class="field"><span>Status</span>
        <select>
          <option>All statuses</option>
          <option>Success</option>
          <option>Pending</option>
          <option>Warning</option>
          <option>Error</option>
        </select>
      </label> -->
  </div>

  <div class="mt">
    <div class="card table-card" data-paginate="10" id="tbl7" style="padding:6px">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>ID</th>
              <th>Member</th>
              <th>Plan</th>
              <th>Amount</th>
              <th>Profit</th>
              <th>Status</th>
              <!-- <th>Action</th> -->
            </tr>
          </thead>
          <tbody>
            <% investments.forEach((investment, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= investment.user.firstName %> <%= investment.user.lastName %></td>
              <td><%= investment.plan.name %></td>
              <td><%= formatCurrency(investment.amount) %></td>
              <td><%= investment.plan.roi %>%</td>
              <td><span class="pill <%= investment.status === 'active' ? 'warning' : 'success' %>"><%= investment.status === 'active' ? 'Active' : 'Completed' %></span></td>
              <!-- <td><button class="btn sm ghost" onclick="openModal('inv-modal')">Adjust</button></td> -->
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="cards-list" style="padding:10px">
        <% investments.forEach(investment => { %>
        <div class="mini-card">
          <div class="row between"><strong><%= investment.user.firstName %> <%= investment.user.lastName %></strong><span class="pill <%= investment.status === 'active' ? 'warning' : 'success' %>"><%= investment.status === 'active' ? 'Active' : 'Completed' %></span></div>
          <div class="mini-row"><span><%= investment.plan.name %></span><span><%= formatCurrency(investment.amount) %></span></div>
          <div class="mini-row"><span>Profit</span><span><%= investment.plan.roi %>%</span></div>
          <!-- <button class="btn sm block" style="margin-top:10px" onclick="openModal('inv-modal')">Adjust</button> -->
        </div>
        <% }) %>
      </div>
      <%- include('partials/pagination') %>
    </div>
  </div>
  <div class="modal-backdrop" id="inv-modal">
    <div class="modal">
      <div class="row between">
        <h3 style="font-size:18px">Adjust investment</h3><button class="icon-btn" onclick="closeModal('inv-modal')"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 6 12 12" />
            <path d="m18 6-12 12" />
          </svg></button>
      </div>
      <div class="mt">
        <form data-demo><label class="field"><span>Profit (USD)</span><input type="number" placeholder="1875" /></label><label class="field"><span>Status</span><select>
              <option>Active</option>
              <option>Completed</option>
              <option>Cancelled</option>
            </select></label><label class="field"><span>Note to member</span><textarea rows="4" placeholder="Profit credited for the current cycle."></textarea></label><button class="btn block" type="submit">Save changes</button>
          <div class="alert success mt" data-demo-note style="display:none">
            <h4>Investment updated</h4>
            <p style="margin:0">Changes are live on the member dashboard.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>
<%- include('partials/adminFooter') %>