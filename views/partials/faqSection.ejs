<%
  const faqs = [
    {
      q: 'What is Polaris Finance?',
      a: 'Polaris Finance is a financial business platform developed under the control of an experienced team of highly qualified financial experts and professional traders for private, highly profitable online investments.',
    },
    {
      q: 'How do I create an account?',
      a: 'Registration is quick and secure. Click on “Get started”, fill in the required details and verify your identity to start earning.',
    },
    {
      q: 'What is the limit for withdrawal?',
      a: 'Your tier limit for payouts upgrades as your earnings grow. The more you earn, the more you can withdraw.',
    },
    {
      q: 'Can I own multiple accounts?',
      a: 'No. Each investor must hold a single account in their own name. Family offices and institutions can request a sub-account structure via Sales.',
    },
    {
      q: 'How can I make a deposit?',
      a: 'Log in, open the Dashboard, click "Deposit", choose a plan and a funding method (bank transfer or crypto), and follow the steps to complete the transaction.',
    },
    {
      q: 'Can I make multiple deposits?',
      a: 'Yes — there is no limit to how many deposits you can make. Each deposit is processed individually and tracked separately in your dashboard. Withdrawals are permitted after every earning cycle is completed. Multiple withdrawals are not supported.',
    },
    {
      q: 'How does cloud mining work at Polaris?',
      a: 'You rent hash power from machines we own and operate in our hosting facilities. We handle the hardware, electricity, cooling and maintenance, and the mining output generated by your share of hash power is credited to your account.',
    },
    {
      q: 'How long does a withdrawal take?',
      a: 'Most withdrawals complete within a few hours during business days. Weekend or off-hours requests may take up to 24 hours to process.',
    },
    {
      q: 'How long for deposits to reflect?',
      a: 'Deposits reflect immediately once they receive on-chain confirmation or bank settlement.',
    },
  ];
  const faqId = typeof faqPrefix !== 'undefined' ? faqPrefix : 'faq';
%>
<div class="pf-faq">
  <% faqs.forEach((item, i) => { const open = i === 0; %>
  <div class="pf-faq-item <%= open ? 'is-open' : '' %>">
    <button type="button" class="pf-faq-question" id="<%= faqId %>-q<%= i %>" aria-expanded="<%= open %>" aria-controls="<%= faqId %>-a<%= i %>">
      <span class="pf-faq-num"><%= String(i + 1).padStart(2, '0') %></span>
      <span class="pf-faq-text"><%= item.q %></span>
      <span class="pf-faq-icon" aria-hidden="true"></span>
    </button>
    <div class="pf-faq-answer" id="<%= faqId %>-a<%= i %>" role="region" aria-labelledby="<%= faqId %>-q<%= i %>" style="height: <%= open ? 'auto' : '0px' %>;">
      <div class="pf-faq-answer-inner"><%= item.a %></div>
    </div>
  </div>
  <% }) %>
</div>
