<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in — Tescomint Investor Portal</title>
  <meta name="description" content="Sign in to your Tescomint account to manage deposits, investments and payouts." />
  <meta property="og:title" content="Sign in — Tescomint Investor Portal" />
  <meta property="og:description" content="Sign in to your Tescomint account to manage deposits, investments and payouts." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="/assets/css/app.css" />
  <script src="/assets/js/app.js" defer></script>
</head>

<body>
  <header class="topbar-inner" style="max-width:1040px">
    <a class="brand" href="/"><span class="brand-mark">T</span><span class="brand-name">Tescomint</span></a>
    <button class="icon-btn" type="button" aria-label="Toggle dark mode" onclick="toggleTheme()"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="8" />
        <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />
      </svg></button>
  </header>
  <main class="auth-wrap">
    <section class="hide-mobile">
      <p class="eyebrow accent">Secure investor access</p>
      <h2 style="font-size:34px;margin-top:12px">Digital asset investing, done seriously.</h2>
      <p class="muted" style="max-width:420px">Track deposits, run investment plans, monitor profits and manage payouts from one clean dashboard.</p>
    </section>
    <section class="auth-card">
      <h1 style="font-size:24px">Welcome back</h1>
      <p class="muted">Sign in to continue to your investor dashboard.</p>
      <div class="mt">
        <form class="login-form">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>Email address</span><input type="email" id="email" placeholder="you@example.com" /></label>
          <label class="field"><span>Password</span><input type="password" id="password" placeholder="••••••••" /></label>
          <div class="row between small" style="margin-bottom:14px">
            <label class="row" style="gap:6px"><input type="checkbox" /> Remember me</label>
            <a href="/forgot-password" style="color:var(--primary);font-weight:700">Forgot password?</a>
          </div>
          <button class="btn block submit-btn" type="submit">Sign in</button>
        </form>
        <p class="muted mt">New to Tescomint? <a href="/register" style="color:var(--primary);font-weight:700">Create an account</a></p>
    </section>
  </main>
</body>
<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  document.querySelector('.login-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const button = document.querySelector('.submit-btn');
    button.disabled = true;
    button.textContent = 'Signing in...';
    button.style.cursor = 'not-allowed';

    try {
      const response = await axios.post('/api/v1/users/login', {
        email: email,
        password: password
      });

      if (response.data.status === 'success') {
        showAlert('success', 'Login Successful', 'You have successfully logged in. Redirecting to dashboard...');
        setTimeout(() => {
          button.disabled = false;
          button.textContent = 'Sign in';
          button.style.cursor = 'pointer';
          window.location.href = '/dashboard';
        }, 1500);
      }
    } catch (error) {
      button.disabled = false;
      button.textContent = 'Sign in';
      button.style.cursor = 'pointer';
      console.error('Error during login:', error.response ? error.response.data : error.message);
      showAlert('error', 'Login Error', error.response && error.response.data && error.response.data.message ? error.response.data.message : 'An unexpected error occurred. Please try again.');
    }
  });
</script>

</html>