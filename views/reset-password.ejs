<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Set a new password — Polaris Finance</title>
  <meta name="description" content="Choose a new password to regain access to your Polaris Finance investor dashboard." />
  <meta property="og:title" content="Set a new password — Polaris Finance" />
  <meta property="og:description" content="Choose a new password to regain access to your Polaris Finance investor dashboard." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="/assets/css/app.css" />
  <script src="/assets/js/app.js" defer></script>
</head>

<body>
  <header class="topbar-inner" style="max-width:1040px">
    <a class="brand" href="/">
      <img src="/assets/home/images/logo.png" style="width: 120px; height: auto;" alt="">
    </a>
    <button class="icon-btn" type="button" aria-label="Toggle dark mode" onclick="toggleTheme()"><svg class="ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="8" />
        <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />
      </svg></button>
  </header>
  <main class="auth-wrap">
    <section class="hide-mobile">
      <p class="eyebrow accent">Secure investor access</p>
      <h2 style="font-size:34px;margin-top:12px">Digital asset investing, done seriously.</h2>
      <p class="muted" style="max-width:420px">Track deposits, run investment plans, monitor profits and manage payouts from one clean dashboard.</p>
    </section>
    <section class="auth-card">
      <h1 style="font-size:24px">Set a new password</h1>
      <p class="muted">Choose a strong password you haven't used before.</p>
      <div class="mt">
        <div class="alert success" data-demo-note style="display:none;margin-bottom:14px">
          <h4>Password updated</h4>
          <p style="margin:0">You can now sign in with your new credentials.</p>
        </div>
        <form class="reset-password-form">
          <div id="alert" style="margin-bottom:14px"></div>
          <label class="field"><span>New password</span><input id="new-password" type="password" placeholder="••••••••" /></label>
          <label class="field"><span>Confirm new password</span><input id="confirm-new-password" type="password" placeholder="••••••••" /></label>
          <button class="btn block submit-btn" type="submit">Update password</button>
        </form>
      </div>
      <p class="muted mt">Done here? <a href="/sign-in" style="color:var(--primary);font-weight:700">Go to sign in</a></p>
    </section>
  </main>
</body>

<script src="/assets/js/alert.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  document.querySelector('.reset-password-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const newPassword = document.getElementById('new-password').value;
    const confirmNewPassword = document.getElementById('confirm-new-password').value;
    const button = document.querySelector('.submit-btn');
    button.disabled = true;
    button.textContent = 'Updating password...';
    button.style.cursor = 'not-allowed';

    if (newPassword !== confirmNewPassword) {
      showAlert('error', 'Password Mismatch', 'Passwords do not match. Please try again.');
      button.disabled = false;
      button.textContent = 'Update password';
      button.style.cursor = 'pointer';
      return;
    }

    try {
      const response = await axios.patch('/api/v1/users/resetPassword/' + window.location.pathname.split('/').pop(), {
        password: newPassword,
        passwordConfirm: confirmNewPassword
      });

      if (response.data.status === 'success') {
        showAlert('success', 'Password updated', 'You can now sign in with your new credentials.');
        document.getElementById('new-password').value = '';
        document.getElementById('confirm-new-password').value = '';
        setTimeout(() => {
          button.disabled = false;
          button.textContent = 'Update password';
          button.style.cursor = 'pointer';
          window.location.href = '/sign-in';
        }, 1500);
      } else {
        button.disabled = false;
        button.textContent = 'Update password';
        button.style.cursor = 'pointer';
        console.error('Password update failed:', response.data);
        showAlert('error', 'Update Error', response.data.message);
      }
    } catch (error) {
      button.disabled = false;
      button.textContent = 'Update password';
      button.style.cursor = 'pointer';
      console.error('Error during password update:', error.response ? error.response.data : error.message);
      showAlert('error', 'Update Error', error.response && error.response.data && error.response.data.message ? error.response.data.message : 'An unexpected error occurred. Please try again.');
    }
  });
</script>

</html>