<%- include('partials/landingPageHeader') %>

<!-- xxx Breadcrumbs xxx -->
<section class="breadcrumbs-wrap">
  <div class="container">
    <ul>
      <li><a href="/"><i class="icofont icofont-home"></i></a></li>
      <li>Investment Plans</li>
    </ul>
    <h1>Investment Plans</h1>
  </div>
</section>
<!-- xxx Breadcrumbs End xxx -->

<div id="body-content">
  <section class="plans-page">
    <div class="container">

      <div class="plans-intro">
        <p class="plans-eyebrow">Our plans</p>
        <h2>Choose a plan that fits your goals</h2>
        <p>
          Professionally managed plans that scale with your portfolio, with
          transparent fees, round-the-clock support and fast withdrawals.
        </p>
      </div>

      <div class="row plans-grid">
        <% plans.forEach((plan, index) => { const featured = index === 1; %>
        <div class="col-lg-4 col-md-6 col-sm-12">
          <article class="plan-card <%= featured ? 'is-featured' : '' %>">

            <header class="plan-card-head">
              <div class="plan-card-title">
                <h3><%= plan.name %></h3>
                <% if (featured) { %>
                <span class="plan-tag">Recommended</span>
                <% } %>
              </div>

              <div class="plan-return">
                <span class="plan-return-value"><%= Math.round(plan.roi * plan.duration) %>%</span>
                <span class="plan-return-label">total return over <%= plan.duration %> days</span>
              </div>
            </header>

            <dl class="plan-specs">
              <div>
                <dt>Minimum deposit</dt>
                <dd><%= formatCurrency(plan.min) %></dd>
              </div>
              <div>
                <dt>Maximum deposit</dt>
                <dd><%= formatCurrency(plan.max) %></dd>
              </div>
              <div>
                <dt>Daily return</dt>
                <dd><%= plan.roi %>%</dd>
              </div>
              <div>
                <dt>Duration</dt>
                <dd><%= plan.duration %> days</dd>
              </div>
              <div>
                <dt>Referral bonus</dt>
                <dd>10%</dd>
              </div>
              <div>
                <dt>Support</dt>
                <dd>24/7</dd>
              </div>
            </dl>

            <a href="/register" class="plan-cta">Get started</a>

          </article>
        </div>
        <% }) %>
      </div>

      <ul class="plans-assurances">
        <li><i class="icofont icofont-check"></i> Transparent fees</li>
        <li><i class="icofont icofont-check"></i> 24/7 customer care</li>
        <li><i class="icofont icofont-check"></i> Fast withdrawals</li>
      </ul>

    </div>
  </section>

  <style>
    /* =========================================
       INVESTMENT PLANS
    ========================================= */

    .plans-page {
      --accent: #f98b06;
      --ink: #101828;
      --muted: #667085;
      --line: #eaecf0;
      padding: 90px 0;
      background: #fafafa;
    }

    /* Intro */
    .plans-intro {
      max-width: 620px;
      margin: 0 auto 56px;
      text-align: center;
    }

    .plans-eyebrow {
      margin: 0 0 10px;
      color: var(--accent);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .04em;
    }

    .plans-intro h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: 32px;
      font-weight: 600;
      line-height: 1.25;
    }

    .plans-intro p:last-child {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.7;
    }

    /* Grid */
    .plans-grid > div {
      display: flex;
      margin-bottom: 30px;
    }

    /* Card */
    .plan-card {
      width: 100%;
      display: flex;
      flex-direction: column;
      padding: 32px 28px 28px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      transition: border-color .2s ease, box-shadow .2s ease;
    }

    .plan-card:hover {
      border-color: #d0d5dd;
      box-shadow: 0 12px 32px rgba(16, 24, 40, .06);
    }

    .plan-card.is-featured {
      border-color: var(--accent);
      box-shadow: 0 12px 32px rgba(249, 139, 6, .08);
    }

    /* Card head */
    .plan-card-head {
      padding-bottom: 24px;
      border-bottom: 1px solid var(--line);
    }

    .plan-card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .plan-card-title h3 {
      margin: 0;
      color: var(--ink);
      font-size: 18px;
      font-weight: 600;
    }

    .plan-tag {
      padding: 4px 10px;
      color: var(--accent);
      background: rgba(249, 139, 6, .08);
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
    }

    .plan-return-value {
      display: block;
      color: var(--ink);
      font-size: 40px;
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: -.02em;
    }

    .plan-return-label {
      display: block;
      margin-top: 6px;
      color: var(--muted);
      font-size: 14px;
    }

    /* Specs */
    .plan-specs {
      flex: 1;
      margin: 0;
      padding: 8px 0 24px;
    }

    .plan-specs > div {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 11px 0;
      border-bottom: 1px dashed var(--line);
    }

    .plan-specs > div:last-child {
      border-bottom: 0;
    }

    .plan-specs dt {
      color: var(--muted);
      font-size: 14px;
      font-weight: 400;
    }

    .plan-specs dd {
      margin: 0;
      color: var(--ink);
      font-size: 14px;
      font-weight: 500;
      text-align: right;
    }

    /* CTA */
    .plan-cta {
      display: block;
      padding: 13px 20px;
      color: var(--ink) !important;
      background: #fff;
      border: 1px solid #d0d5dd;
      border-radius: 8px;
      text-align: center;
      text-decoration: none !important;
      font-size: 15px;
      font-weight: 500;
      transition: background .2s ease, border-color .2s ease, color .2s ease;
    }

    .plan-cta:hover {
      color: var(--accent) !important;
      border-color: var(--accent);
    }

    .is-featured .plan-cta {
      color: #fff !important;
      background: var(--accent);
      border-color: var(--accent);
    }

    .is-featured .plan-cta:hover {
      color: #fff !important;
      background: #e07c00;
      border-color: #e07c00;
    }

    /* Assurances */
    .plans-assurances {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 36px;
      margin: 26px 0 0;
      padding: 0;
      list-style: none;
    }

    .plans-assurances li {
      color: var(--muted);
      font-size: 14px;
    }

    .plans-assurances i {
      margin-right: 6px;
      color: var(--accent);
    }

    /* Responsive */
    @media (max-width: 767px) {
      .plans-page {
        padding: 60px 0;
      }

      .plans-intro {
        margin-bottom: 40px;
      }

      .plans-intro h2 {
        font-size: 26px;
      }

      .plan-card {
        padding: 26px 22px 22px;
      }

      .plan-return-value {
        font-size: 34px;
      }
    }
  </style>

  <!-- xxx Google Map xxx -->
  <section class="home-pad">
    <div id="map-holder-contact">
      <iframe src="https://www.google.com/maps/embed?pb=!1m10!1m8!1m3!1d6624.986066388227!2d151.221839!3d-33.876954!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sus!4v1582101032155!5m2!1sen!2sus" style="border:0;" allowfullscreen=""></iframe>
    </div>
  </section><!-- xxx Google Map End xxx -->

  <%- include('partials/landingPageFooter') %>