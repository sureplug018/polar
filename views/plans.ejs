<%- include('partials/landingPageHeader') %>

<div id="body-content">
    <section class="wide-tb-100">
      <div class="container">
        <div class="row">
          <!-- Heading Main -->
          <div class="col-sm-12">
            <h1 style="text-align: center;">Investment Plans</h1>
            <h1 class="heading-main">
              <span>Scale with Confidence at Every Stage—Flexible, Professionally Designed Plans That Grow Seamlessly with Your Portfolio </span>
              Transparent fees , 24/hours customer care , Fast Withdraw
            </h1>
          </div>
          <!-- Investment Plans -->
          <section class="investment-plans">
            <div class="container">

              <div class="plans-heading">
                <span>Investment Plans</span>
                <h2>Choose the plan that works for you</h2>
                <p>
                  Select an investment plan and start growing your investment today.
                </p>
              </div>

              <div class="row g-4">
                <% plans.forEach((plan, index) => { %>

                <!-- Investment Plan Card -->
                <div class="col-md-4 col-sm-12">
                  <div class="investment-card <%= index === 1 ? 'featured-plan' : '' %>">

                    <% if (index === 1) { %>
                    <div class="popular-badge">Most Popular</div>
                    <% } %>

                    <!-- Plan Header -->
                    <div class="plan-header">
                      <h3><%= plan.name %></h3>

                      <div class="plan-roi">
                        <span><%= Math.round(plan.roi * plan.duration) %></span><sup>%</sup>
                        <small> ROI</small>
                      </div>
                    </div>

                    <!-- Plan Features -->
                    <div class="plan-features">

                      <div class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>
                          Minimum investment
                          <strong><%= formatCurrency(plan.min) %></strong>
                        </span>
                      </div>

                      <div class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>
                          Maximum investment
                          <strong><%= formatCurrency(plan.max) %></strong>
                        </span>
                      </div>

                      <div class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>
                          Investment duration
                          <strong><%= plan.duration %></strong>
                        </span>
                      </div>

                      <div class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>
                          Daily return
                          <strong><%= plan.roi %>% ROI</strong>
                        </span>
                      </div>

                      <div class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>
                          Referral bonus
                          <strong>10%</strong>
                        </span>
                      </div>

                      <div class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>
                          Secure investment
                          <strong>Available</strong>
                        </span>
                      </div>

                    </div>

                    <!-- CTA -->
                    <a href="/register" class="plan-button">
                      Get Started
                      <span>→</span>
                    </a>

                  </div>
                </div>

                <% }) %>
              </div>

            </div>
          </section>


          <style>
            /* =========================================
   INVESTMENT PLANS
========================================= */

            .investment-plans {
              padding: 80px 0;
              background: #f7f9fc;
            }

            /* Heading */
            .plans-heading {
              text-align: center;
              max-width: 650px;
              margin: 0 auto 50px;
            }

            .plans-heading>span {
              display: inline-block;
              color: #f98b06;
              background: #eaf1ff;
              font-size: 13px;
              font-weight: 700;
              text-transform: uppercase;
              letter-spacing: 1px;
              padding: 8px 16px;
              border-radius: 30px;
              margin-bottom: 15px;
            }

            .plans-heading h2 {
              margin: 0 0 12px;
              color: #101828;
              font-size: 36px;
              font-weight: 700;
            }

            .plans-heading p {
              margin: 0;
              color: #667085;
              font-size: 16px;
              line-height: 1.7;
            }


            /* =========================================
   CARD
========================================= */

            .investment-card {
              position: relative;
              height: 100%;
              padding: 32px 28px;
              background: #ffffff;
              border: 1px solid #e5e7eb;
              border-radius: 18px;

              display: flex;
              flex-direction: column;

              box-shadow: 0 8px 30px rgba(16, 24, 40, 0.06);

              transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;
            }

            .investment-card:hover {
              transform: translateY(-8px);
              border-color: #b8cfff;
              box-shadow: 0 18px 45px rgba(16, 24, 40, 0.12);
            }


            /* =========================================
   FEATURED PLAN
========================================= */

            .featured-plan {
              border: 2px solid #f98b06;
              box-shadow: 0 15px 45px rgba(23, 78, 166, 0.15);
            }

            .popular-badge {
              position: absolute;
              top: -14px;
              left: 50%;
              transform: translateX(-50%);

              padding: 7px 20px;

              background: #f98b06;
              color: #fff;

              border-radius: 30px;

              font-size: 12px;
              font-weight: 700;
              white-space: nowrap;
              text-transform: uppercase;
              letter-spacing: .5px;
            }


            /* =========================================
   PLAN HEADER
========================================= */

            .plan-header {
              text-align: center;
              padding-bottom: 25px;
              border-bottom: 1px solid #edf0f5;
            }

            .plan-header h3 {
              margin: 0 0 18px;
              color: #101828;
              font-size: 21px;
              font-weight: 700;
            }

            .plan-roi {
              color: #f98b06;
              font-size: 18px;
              font-weight: 600;
            }

            .plan-roi span {
              font-size: 52px;
              line-height: 1;
              font-weight: 800;
              letter-spacing: -2px;
            }

            .plan-roi sup {
              position: relative;
              top: -22px;
              font-size: 20px;
              font-weight: 700;
            }

            .plan-roi small {
              display: block;
              margin-top: 8px;

              color: #667085;
              font-size: 13px;
              font-weight: 500;
            }


            /* =========================================
   FEATURES
========================================= */

            .plan-features {
              padding: 22px 0;
              flex: 1;
            }

            .feature-item {
              display: flex;
              align-items: flex-start;
              gap: 12px;

              padding: 12px 0;

              color: #667085;
              font-size: 14px;
              line-height: 1.5;
            }

            .check-icon {
              flex-shrink: 0;

              width: 22px;
              height: 22px;

              display: flex;
              align-items: center;
              justify-content: center;

              margin-top: 1px;

              background: #eaf7ef;
              color: #16a34a;

              border-radius: 50%;

              font-size: 12px;
              font-weight: 800;
            }

            .feature-item strong {
              display: block;
              margin-top: 2px;

              color: #101828;
              font-size: 14px;
              font-weight: 600;
            }


            /* =========================================
   BUTTON
========================================= */

            .plan-button {
              width: 100%;

              display: flex;
              align-items: center;
              justify-content: center;
              gap: 10px;

              padding: 14px 20px;

              background: #f98b06;
              color: #fff !important;

              border: 1px solid #f98b06;
              border-radius: 8px;

              text-decoration: none !important;

              font-size: 14px;
              font-weight: 700;

              transition: all .25s ease;
            }

            .plan-button span {
              font-size: 19px;
              line-height: 1;

              transition: transform .25s ease;
            }

            .plan-button:hover {
              background: #0d3b82;
              border-color: #0d3b82;
              color: #fff !important;
            }

            .plan-button:hover span {
              transform: translateX(4px);
            }


            /* =========================================
   RESPONSIVE
========================================= */

            @media (max-width: 991px) {
              .investment-plans {
                padding: 60px 0;
              }

              .investment-card {
                margin-bottom: 10px;
              }
            }

            @media (max-width: 767px) {
              .plans-heading h2 {
                font-size: 28px;
              }

              .investment-card {
                padding: 28px 22px;
              }

              .plan-roi span {
                font-size: 45px;
              }
            }
          </style>
        </div>
      </div>
    </section>

  <!-- xxx Google Map xxx -->
  <section class="home-pad">
    <div id="map-holder-contact">
      <iframe src="https://www.google.com/maps/embed?pb=!1m10!1m8!1m3!1d6624.986066388227!2d151.221839!3d-33.876954!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sus!4v1582101032155!5m2!1sen!2sus" style="border:0;" allowfullscreen=""></iframe>
    </div>
  </section><!-- xxx Google Map End xxx -->

  <%- include('partials/landingPageFooter') %>